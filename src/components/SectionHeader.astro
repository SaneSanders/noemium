---
interface Props {
  index: string;
  title: string;
  sub?: string;
}

const { index, title, sub } = Astro.props;
---

<header class="py-12 md:py-16">
  <p class="font-mono text-xs text-shift-near">{index} /{title.toUpperCase()}</p>
  <h1 class="mt-3 font-display text-4xl leading-tight md:text-6xl">
    <slot>{title}</slot>
  </h1>
  {sub && <p class="mt-4 max-w-2xl text-ink-dim">{sub}</p>}
</header>
