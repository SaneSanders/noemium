---
interface Props {
  title: string;
  sub?: string;
}

const { title, sub } = Astro.props;
---

<header class="py-14 md:py-20">
  <p class="flex items-center gap-3 font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
    <span aria-hidden="true" class="inline-block h-0.5 w-9 bg-accent"></span>
    {title}
  </p>
  <h1 class="text-shadow-section mt-6 font-display text-5xl leading-[0.98] font-black tracking-tight uppercase md:text-7xl">
    <slot>{title}</slot>
  </h1>
  {sub && <p class="mt-6 max-w-2xl text-lg leading-relaxed font-medium text-ink opacity-75">{sub}</p>}
</header>
