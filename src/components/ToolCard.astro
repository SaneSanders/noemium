---
import type { CollectionEntry } from 'astro:content';
import VerdictBadge from './VerdictBadge.astro';
import ShiftArrow from './ShiftArrow.astro';

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const t = tool.data;

const flags = [t.open_source && 'OSS', t.api && 'API', t.free_tier && 'FREE TIER'].filter(
  Boolean,
) as string[];
---

<a
  href={`/tools/${tool.id}`}
  class="group block rounded-md border border-line bg-panel p-5 transition-colors duration-200 hover:border-shift-near hover:bg-raised"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-body text-lg font-semibold text-ink group-hover:text-shift-near">
      {t.name}
      {t.featured && <span class="ml-2 font-mono text-xs tracking-widest text-gold uppercase">featured</span>}
    </h3>
    <ShiftArrow momentum={t.momentum} class="mt-1 shrink-0" />
  </div>
  <p class="mt-2 text-sm text-ink-dim">{t.tagline}</p>
  <p class="mt-4 font-mono text-xs tracking-widest text-ink-dim uppercase">{t.category}</p>
  <p class="nm-num mt-1 text-xs text-ink">
    {t.pricing}{t.price_note && <span class="text-ink-dim"> · {t.price_note}</span>}
  </p>
  {
    flags.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-1.5">
        {flags.map((flag) => (
          <span class="rounded-sm border border-line px-1.5 py-0.5 font-mono text-xs text-ink-dim">
            {flag}
          </span>
        ))}
      </p>
    )
  }
  <div class="mt-4 flex items-center justify-between gap-3">
    <VerdictBadge verdict={t.verdict} />
    <span class="font-mono text-xs text-ink-dim">verified {t.last_verified}</span>
  </div>
</a>
