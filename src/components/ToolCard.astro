---
import type { CollectionEntry } from 'astro:content';
import VerdictBadge from './VerdictBadge.astro';
import ShiftArrow from './ShiftArrow.astro';
import VerifiedStamp from './VerifiedStamp.astro';
import { logoSrc } from '../lib/logos';

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const t = tool.data;
const logo = logoSrc(tool.id);

const flags = [t.open_source && 'OSS', t.api && 'API', t.free_tier && 'FREE TIER'].filter(
  Boolean,
) as string[];
---

<article
  class="nm-card nm-card-hover group relative flex flex-col p-6"
  data-nm-card="tool"
  data-slug={tool.id}
  data-name={t.name}
  data-tagline={t.tagline}
  data-category={t.category}
  data-pricing={t.pricing}
  data-verdict={t.verdict}
  data-momentum={t.momentum}
  data-free-tier={String(t.free_tier)}
  data-open-source={String(t.open_source)}
  data-api={String(t.api)}
>
  <a
    href={`/tools/${tool.id}/`}
    class="absolute inset-0 z-0"
    aria-label={`${t.name} — ${t.tagline}`}
  >
    <span class="sr-only">{t.name}</span>
  </a>
  <div class="relative z-10 flex flex-1 flex-col pointer-events-none">
    <div class="flex items-start justify-between gap-3">
      <span class="font-mono text-[13px] font-medium tracking-[0.1em] text-ink-dim uppercase">
        {t.category}
      </span>
      <VerdictBadge verdict={t.verdict} />
    </div>
    <div class="mt-4 flex items-center gap-3">
      {
        logo ? (
          <img
            src={logo}
            alt=""
            width="32"
            height="32"
            loading="lazy"
            class="h-8 w-8 shrink-0 rounded-sm border-[1.5px] border-ink bg-card object-contain p-0.5"
          />
        ) : (
          <span
            aria-hidden="true"
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-sm border-[1.5px] border-ink bg-paper font-display text-lg font-black text-accent"
          >
            {t.name.charAt(0)}
          </span>
        )
      }
      <h3 class="font-display text-2xl font-extrabold tracking-tight text-ink group-hover:text-accent">
        {t.name}
        {t.featured && (
          <span
            class="ml-2 align-middle font-mono text-[11px] font-medium tracking-[0.14em] text-accent uppercase"
            title="Editorial mix on the floor — not a paid placement"
          >
            anchor
          </span>
        )}
      </h3>
    </div>
    <p class="mt-3 flex-1 text-[15px] leading-relaxed text-ink opacity-80">{t.tagline}</p>
    {
      flags.length > 0 && (
        <p class="mt-4 flex flex-wrap gap-1.5">
          {flags.map((flag) => (
            <span class="rounded-sm border-[1.5px] border-ink px-2 py-1 font-mono text-[11px] font-medium tracking-wider text-ink">
              {flag}
            </span>
          ))}
        </p>
      )
    }
    <div class="mt-5 border-t-[1.5px] border-line-soft pt-4">
      <p class="nm-num text-[15px] font-bold text-accent">
        {t.pricing}
        {t.free_tier && t.pricing === 'paid' && (
          <span class="block pt-1 text-[13px] font-normal text-ink opacity-60">
            free allowance — paid to keep using
          </span>
        )}
        {t.price_note && <span class="block pt-1 text-[13px] font-normal text-ink opacity-60">{t.price_note}</span>}
      </p>
      <div class="mt-4 flex items-center justify-between gap-3">
        <span class="pointer-events-auto">
          <VerifiedStamp slug={tool.id} date={t.last_verified} />
        </span>
        <ShiftArrow momentum={t.momentum} />
      </div>
    </div>
  </div>
</article>
