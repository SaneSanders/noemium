---
import type { CollectionEntry } from 'astro:content';
import VerdictBadge from './VerdictBadge.astro';
import ShiftArrow from './ShiftArrow.astro';
import { toolNumbers, formatEntryNo } from '../lib/tool-numbers';

interface Props {
  tool: CollectionEntry<'tools'>;
}

const { tool } = Astro.props;
const t = tool.data;
const numbers = await toolNumbers();

const flags = [t.open_source && 'OSS', t.api && 'API', t.free_tier && 'FREE TIER'].filter(
  Boolean,
) as string[];
---

<a
  href={`/tools/${tool.id}`}
  class="nm-card nm-card-hover group flex flex-col p-6"
>
  <div class="flex items-start justify-between gap-3">
    <span class="font-mono text-[11px] font-medium tracking-[0.12em] text-ink-dim">
      {formatEntryNo(numbers.get(tool.id))}
    </span>
    <VerdictBadge verdict={t.verdict} />
  </div>
  <h3 class="mt-4 font-display text-2xl font-extrabold tracking-tight text-ink group-hover:text-accent">
    {t.name}
    {t.featured && <span class="ml-2 align-middle font-mono text-[10px] font-medium tracking-[0.14em] text-accent uppercase">featured</span>}
  </h3>
  <p class="mt-1 font-mono text-[11px] tracking-[0.08em] text-ink-dim uppercase">{t.category}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink opacity-80">{t.tagline}</p>
  {
    flags.length > 0 && (
      <p class="mt-4 flex flex-wrap gap-1.5">
        {flags.map((flag) => (
          <span class="rounded-sm border-[1.5px] border-ink px-1.5 py-0.5 font-mono text-[10px] font-medium tracking-wider text-ink">
            {flag}
          </span>
        ))}
      </p>
    )
  }
  <div class="mt-5 border-t-[1.5px] border-line-soft pt-4">
    <p class="nm-num text-sm font-bold text-accent">
      {t.pricing}{t.price_note && <span class="block pt-1 text-[13px] font-normal text-ink opacity-60">{t.price_note}</span>}
    </p>
    <div class="mt-4 flex items-center justify-between gap-3">
      <span class="nm-verified">Verified {t.last_verified}</span>
      <ShiftArrow momentum={t.momentum} />
    </div>
  </div>
</a>
