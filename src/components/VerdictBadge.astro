---
interface Props {
  verdict: 'ship' | 'situational' | 'skip';
  class?: string;
}

const { verdict, class: className = '' } = Astro.props;

const tone: Record<Props['verdict'], string> = {
  ship: 'nm-sticker-ship',
  situational: 'nm-sticker-situational',
  skip: 'nm-sticker-skip',
};
---

<span class:list={['nm-sticker', tone[verdict], className]}>
  {verdict}
</span>
