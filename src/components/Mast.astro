---
interface Props {
  page?: 'home' | 'map' | 'autopsy' | 'signals' | 'reference' | 'method' | '';
}

const { page = '' } = Astro.props;
const hasEnd = Astro.slots.has('end');

const items = [
  { id: 'map', href: '/map/', label: 'Map' },
  { id: 'autopsy', href: '/autopsy/', label: 'Autopsy' },
  { id: 'home', href: '/', label: 'Noemium', brand: true },
  { id: 'reference', href: '/reference/', label: 'Catalog' },
  { id: 'method', href: '/method/', label: 'Method' },
] as const;
---

<header class:list={['mast', hasEnd && 'mast-has-end']} data-shell="1">
  <nav class="mast-nav" aria-label="Primary">
    {
      items.map((d) =>
        d.brand ? (
          <a class="brand" href={d.href}>
            {d.label}
          </a>
        ) : (
          <a href={d.href} aria-current={d.id === page ? 'page' : undefined}>
            {d.label}
          </a>
        ),
      )
    }
  </nav>
  {
    hasEnd ? (
      <div class="mast-end">
        <slot name="end" />
      </div>
    ) : null
  }
</header>
