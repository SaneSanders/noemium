---
import { ClientRouter } from 'astro:transitions';
import '../styles/theme.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import CommandPalette from '../islands/CommandPalette';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Noemium — an open, auditable directory of AI tools, stacks and models. No pay-to-list. Every recommendation is a PR you can audit.',
  ogImage = '/og/noemium.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const navItems = [
  { index: '01', href: '/tools', label: '/TOOLS', name: 'Tools' },
  { index: '02', href: '/stacks', label: '/STACKS', name: 'Stacks' },
  { index: '03', href: '/models', label: '/MODELS', name: 'Models' },
  { index: '04', href: '/quiz', label: '/QUIZ', name: 'Quiz' },
  { index: '05', href: '/contribute', label: '/CONTRIBUTE', name: 'Contribute' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Noemium</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Noemium observations" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} — Noemium`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Noemium" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-void font-body text-ink antialiased">
    {/* Scroll-depth readout — 1px progress line + mono percentage. */}
    <div aria-hidden="true" class="pointer-events-none fixed inset-x-0 top-0 z-40 h-px bg-transparent">
      <div id="nm-depth-bar" class="h-px origin-left scale-x-0 bg-shift-near"></div>
    </div>
    <span
      id="nm-depth-num"
      aria-hidden="true"
      class="nm-num pointer-events-none fixed right-3 bottom-3 z-40 text-xs text-ink-dim"
    >
      DEPTH 000%
    </span>

    <header class="border-b border-line bg-panel">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
        <a href="/" class="flex items-baseline gap-2">
          <span class="font-display text-2xl tracking-wide">NOEMIUM</span>
          <span class="font-mono text-xs text-ink-dim">observatory</span>
        </a>
        <nav class="hidden items-center gap-6 md:flex">
          {
            navItems.map((item) => (
              <a href={item.href} class="font-mono text-xs text-ink-dim transition-colors hover:text-ink">
                <span class="text-shift-near">{item.index}</span> {item.label}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-3">
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('nm:palette:open'))"
            class="rounded-sm border border-line px-3 py-1 font-mono text-xs text-ink-dim transition-colors hover:border-shift-near hover:text-ink"
            aria-label="Open command palette (⌘K)"
          >
            ⌘K
          </button>
          <a
            href="https://github.com/SaneSanders/noemium"
            class="hidden rounded-sm border border-line px-3 py-1 font-mono text-xs text-ink-dim transition-colors hover:border-shift-near hover:text-ink sm:inline-block"
            rel="noopener"
          >
            Star on GitHub
          </a>
          <button
            id="nm-nav-open"
            type="button"
            aria-expanded="false"
            aria-controls="nm-mobile-nav"
            aria-label="Open menu"
            class="rounded-sm border border-line p-1.5 text-ink-dim transition-colors hover:border-shift-near hover:text-ink md:hidden"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M2 4h12M2 8h12M2 12h12" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    {/* Mobile navigation overlay — same 01–05 links, display type. */}
    <div
      id="nm-mobile-nav"
      class="fixed inset-0 z-50 hidden flex-col bg-void"
      role="dialog"
      aria-modal="true"
      aria-label="Site navigation"
    >
      <div class="flex items-center justify-between border-b border-line px-4 py-4">
        <span class="font-display text-2xl tracking-wide">NOEMIUM</span>
        <button
          id="nm-nav-close"
          type="button"
          aria-label="Close menu"
          class="rounded-sm border border-line p-1.5 text-ink-dim transition-colors hover:border-shift-near hover:text-ink"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 3l10 10M13 3L3 13" />
          </svg>
        </button>
      </div>
      <nav class="flex flex-1 flex-col justify-center px-6">
        {
          navItems.map((item) => (
            <a href={item.href} class="group flex items-baseline gap-4 border-b border-line py-4 last:border-b-0">
              <span class="font-mono text-xs text-shift-near">{item.index}</span>
              <span class="font-display text-4xl text-ink transition-colors group-hover:text-shift-near">
                {item.name}
              </span>
            </a>
          ))
        }
      </nav>
    </div>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4">
      <slot />
    </main>

    <footer class="mt-16 border-t border-line bg-panel">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 font-mono text-xs text-ink-dim">
        <p>
          Built in the open by{' '}
          <a href="https://x.com/whysanesanders" class="text-shift-near hover:underline" rel="noopener">
            @whysanesanders
          </a>
        </p>
        <p>Some links are affiliate links — always declared. No paid listings, ever.</p>
        <p class="flex gap-4">
          <a href="https://github.com/SaneSanders/noemium" class="hover:text-ink" rel="noopener">GitHub</a>
          <a href="/contribute" class="hover:text-ink">Contribute</a>
          <a href="/search" class="hover:text-ink">Search</a>
          <a href="/rss.xml" class="hover:text-ink">RSS</a>
        </p>
      </div>
    </footer>

    <CommandPalette client:idle transition:persist />

    <script>
      // Scroll-depth readout. Listeners re-bind on every view transition;
      // the previous one is dropped before each swap.
      let depthHandler: (() => void) | null = null;

      function bindDepth() {
        const bar = document.getElementById('nm-depth-bar');
        const num = document.getElementById('nm-depth-num');
        if (!bar || !num) return;
        let ticking = false;
        const update = () => {
          ticking = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          bar.style.transform = `scaleX(${p})`;
          num.textContent = `DEPTH ${String(Math.round(p * 100)).padStart(3, '0')}%`;
        };
        depthHandler = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener('scroll', depthHandler, { passive: true });
        update();
      }

      document.addEventListener('astro:page-load', bindDepth);
      document.addEventListener('astro:before-swap', () => {
        if (depthHandler) {
          window.removeEventListener('scroll', depthHandler);
          depthHandler = null;
        }
      });

      // Mobile nav overlay. Delegated listeners bind once and survive view
      // transitions (the document persists; the header markup is swapped).
      function setMobileNav(open: boolean) {
        const overlay = document.getElementById('nm-mobile-nav');
        if (!overlay) return;
        overlay.classList.toggle('hidden', !open);
        overlay.classList.toggle('flex', open);
        document.getElementById('nm-nav-open')?.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      }
      document.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (t.closest('#nm-nav-open')) setMobileNav(true);
        else if (t.closest('#nm-nav-close') || t.closest('#nm-mobile-nav a')) setMobileNav(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMobileNav(false);
      });
      document.addEventListener('astro:before-swap', () => setMobileNav(false));
    </script>
  </body>
</html>
