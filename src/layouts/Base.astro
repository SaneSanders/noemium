---
import { ClientRouter } from 'astro:transitions';
import '../styles/theme.css';
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/900.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import CommandPalette from '../islands/CommandPalette';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Noemium — an open, auditable directory of AI tools, stacks and models. No pay-to-list. Every recommendation is a PR you can audit.',
  ogImage = '/og/noemium.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const navItems = [
  { href: '/tools', name: 'Tools' },
  { href: '/stacks', name: 'Stacks' },
  { href: '/models', name: 'Models' },
  { href: '/quiz', name: 'Quiz' },
  { href: '/tools/compare', name: 'Compare' },
  { href: '/changelog', name: 'Changelog' },
  { href: '/contribute', name: 'Contribute' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Dark-first theming: :root is dark, `data-theme="light"` opts into the
      // light theme. Runs before paint to avoid a flash of the wrong theme.
      if (localStorage.getItem('nm-theme') === 'light') {
        document.documentElement.dataset.theme = 'light';
      }
      document.addEventListener('astro:before-swap', (e) => {
        const t = document.documentElement.dataset.theme;
        if (t) e.newDocument.documentElement.dataset.theme = t;
      });
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>Noemium — {title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Noemium observations" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Noemium — ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Noemium" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-paper font-body text-ink antialiased">
    <header class="pt-6">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6">
        <a href="/" class="font-display text-2xl font-extrabold tracking-tight text-ink">
          noemium<sup class="ml-1.5 align-super font-mono text-[10px] font-medium tracking-wider text-accent uppercase">open beta</sup>
        </a>
        <nav class="hidden items-center gap-7 lg:flex">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class="text-sm font-semibold tracking-tight text-ink opacity-70 transition-opacity duration-100 hover:opacity-100"
              >
                {item.name}
              </a>
            ))
          }
        </nav>
        <div class="flex items-center gap-3">
          <button
            id="nm-theme-toggle"
            type="button"
            aria-label="Toggle light theme"
            class="rounded-md border-[1.5px] border-ink bg-card p-2 text-ink shadow-hard-sm transition-all duration-100 hover:-translate-0.5 hover:shadow-hard"
          >
            <svg
              class="nm-icon-sun"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="8" cy="8" r="3.5" />
              <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M12.6 3.4l-1 1M4.4 11.6l-1 1" />
            </svg>
            <svg
              class="nm-icon-moon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z" />
            </svg>
          </button>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('nm:palette:open'))"
            class="hidden items-center gap-2.5 rounded-full border-[1.5px] border-ink bg-card px-4 py-2 font-mono text-[13px] font-medium text-ink shadow-hard-sm transition-all duration-100 hover:-translate-0.5 hover:shadow-hard sm:inline-flex"
            aria-label="Open command palette (⌘K)"
          >
            <span>Search</span>
            <span class="text-[11px] opacity-55">⌘K</span>
          </button>
          <button
            id="nm-nav-open"
            type="button"
            aria-expanded="false"
            aria-controls="nm-mobile-nav"
            aria-label="Open menu"
            class="rounded-md border-[1.5px] border-ink bg-card p-2 text-ink shadow-hard-sm lg:hidden"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M2 4h12M2 8h12M2 12h12" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    {/* Mobile navigation overlay — same links, display type. */}
    <div
      id="nm-mobile-nav"
      class="fixed inset-0 z-50 hidden flex-col bg-paper"
      role="dialog"
      aria-modal="true"
      aria-label="Site navigation"
    >
      <div class="flex items-center justify-between border-b-[1.5px] border-ink px-6 py-5">
        <span class="font-display text-2xl font-extrabold tracking-tight">noemium</span>
        <button
          id="nm-nav-close"
          type="button"
          aria-label="Close menu"
          class="rounded-md border-[1.5px] border-ink bg-card p-2 text-ink shadow-hard-sm"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 3l10 10M13 3L3 13" />
          </svg>
        </button>
      </div>
      <nav class="flex flex-1 flex-col justify-center px-6">
        {
          navItems.map((item) => (
            <a href={item.href} class="group flex items-baseline gap-4 border-b border-line-soft py-4 last:border-b-0">
              <span class="font-display text-4xl font-extrabold tracking-tight text-ink uppercase transition-colors group-hover:text-accent">
                {item.name}
              </span>
            </a>
          ))
        }
      </nav>
    </div>

    <main class="mx-auto w-full max-w-7xl flex-1 px-6">
      <slot />
    </main>

    <footer class="mt-20 border-t-[1.5px] border-ink">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-6 py-10">
        <p class="font-mono text-[13px] font-medium tracking-wide text-ink">
          Code <span class="font-bold text-accent">MIT</span> · Content <span class="font-bold text-accent">CC BY 4.0</span> · Every recommendation is a PR
        </p>
        <p class="w-full font-mono text-[11px] text-ink-dim">
          Some outbound links are affiliate links — always declared, never affecting verdicts.
        </p>
        <p class="flex items-center gap-5 font-mono text-xs text-ink-dim">
          <a href="https://github.com/SaneSanders/noemium" class="hover:text-ink" rel="noopener">GitHub</a>
          <a href="/contribute" class="hover:text-ink">Contribute</a>
          <a href="/search" class="hover:text-ink">Search</a>
          <a href="/graveyard" class="hover:text-ink">Graveyard</a>
          <a href="/rss.xml" class="hover:text-ink">RSS</a>
          <a href="https://x.com/whysanesanders" class="hover:text-ink" rel="noopener">@whysanesanders</a>
        </p>
        <span class="font-display text-lg font-extrabold tracking-tight">noemium</span>
      </div>
    </footer>

    <CommandPalette client:idle transition:persist />

    <script>
      // Mobile nav overlay. Delegated listeners bind once and survive view
      // transitions (the document persists; the header markup is swapped).
      function setMobileNav(open: boolean) {
        const overlay = document.getElementById('nm-mobile-nav');
        if (!overlay) return;
        overlay.classList.toggle('hidden', !open);
        overlay.classList.toggle('flex', open);
        document.getElementById('nm-nav-open')?.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
      }
      document.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (t.closest('#nm-theme-toggle')) {
          const root = document.documentElement;
          const light = root.dataset.theme === 'light';
          if (light) delete root.dataset.theme;
          else root.dataset.theme = 'light';
          localStorage.setItem('nm-theme', light ? 'dark' : 'light');
        } else if (t.closest('#nm-nav-open')) setMobileNav(true);
        else if (t.closest('#nm-nav-close') || t.closest('#nm-mobile-nav a')) setMobileNav(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setMobileNav(false);
      });
      document.addEventListener('astro:before-swap', () => setMobileNav(false));
    </script>
  </body>
</html>
