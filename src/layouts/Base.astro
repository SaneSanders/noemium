---
import { ClientRouter } from 'astro:transitions';
import '../styles/theme.css';
import '../styles/cover.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import Mast from '../components/Mast.astro';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import CommandPalette from '../islands/CommandPalette';
import ProofDrawer from '../islands/ProofDrawer';
import { COMPARE_HREF } from '../lib/shelf';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Noemium — pick AI tools without getting played. An open catalog of AI tools, stacks and models. No pay-to-list. Every recommendation is a PR you can audit.',
  ogImage = '/og-default.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
const path = Astro.url.pathname;
const navItems = [
  { href: '/tools/', name: 'Tools' },
  { href: '/agents/', name: 'Agents' },
  { href: '/stacks/', name: 'Stacks' },
  { href: '/models/', name: 'Models' },
  { href: '/jobs/', name: 'Jobs' },
  { href: COMPARE_HREF, name: 'Compare' },
  { href: '/changelog/', name: 'Changelog' },
  { href: '/about/', name: 'About' },
];

function navCurrent(href: string): boolean {
  const clean = href.split('?')[0] ?? href;
  if (clean === '/tools') {
    return path === '/tools' || (path.startsWith('/tools/') && !path.startsWith('/tools/compare'));
  }
  if (clean === '/tools/compare') return path.startsWith('/tools/compare');
  if (clean === '/quiz') return path === '/quiz' || path.startsWith('/quiz/');
  if (clean === '/jobs') return path === '/jobs' || path.startsWith('/jobs/');
  return path === clean || path.startsWith(`${clean}/`);
}

const mastPage = (
  path.startsWith('/map') ? 'map'
  : path.startsWith('/autopsy') ? 'autopsy'
  : path.startsWith('/signals') ? 'signals'
  : path.startsWith('/reference') ? 'reference'
  : path.startsWith('/method') ? 'method'
  : ''
) as 'map' | 'autopsy' | 'signals' | 'reference' | 'method' | '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Dark-first theming: :root is dark, `data-theme="light"` opts into the
      // light theme. Runs before paint to avoid a flash of the wrong theme.
      try {
        if (localStorage.getItem('nm-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
        }
      } catch {}
      document.addEventListener('astro:before-swap', (e) => {
        const t = document.documentElement.dataset.theme;
        if (t) e.newDocument.documentElement.dataset.theme = t;
      });
    </script>
    <meta name="generator" content={Astro.generator} />
    <title>Noemium — {title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Noemium — weekly risk feed" href="/rss.xml" />
    <slot name="head" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Noemium — ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Noemium" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Noemium — ${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:site" content="@noemiumai" />
    <ClientRouter />
    {
      cfBeacon && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeacon })}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-paper font-body text-ink antialiased">
    <a
      href="#nm-main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:border-[1.5px] focus:border-ink focus:bg-accent focus:px-3 focus:py-2 focus:font-mono focus:text-sm focus:text-on-accent"
    >
      Skip to content
    </a>
    <Mast page={mastPage}>
      <div slot="end" class="flex items-center gap-3">
          <button
            id="nm-theme-toggle"
            type="button"
            aria-label="Switch to light theme"
            aria-pressed="false"
            class="inline-flex h-9 w-9 items-center justify-center border border-[color-mix(in_srgb,var(--nm-cream)_22%,transparent)] bg-transparent text-[var(--nm-cream)]"
          >
            <svg
              class="nm-icon-sun"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="8" cy="8" r="3.5" />
              <path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1 1M11.6 11.6l1 1M12.6 3.4l-1 1M4.4 11.6l-1 1" />
            </svg>
            <svg
              class="nm-icon-moon"
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M13.5 9.5A6 6 0 0 1 6.5 2.5a6 6 0 1 0 7 7Z" />
            </svg>
          </button>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('nm:palette:open'))"
            class="inline-flex h-9 items-center gap-2.5 border border-[color-mix(in_srgb,var(--nm-cream)_22%,transparent)] bg-transparent px-3 font-mono text-[14px] tracking-wide text-[var(--nm-cream)]"
            aria-label="Open command palette (⌘K)"
          >
            <span>Search</span>
            <span class="hidden text-[13px] opacity-55 sm:inline">⌘K</span>
          </button>
          <button
            id="nm-nav-open"
            type="button"
            aria-expanded="false"
            aria-controls="nm-mobile-nav"
            aria-label="Open menu"
            class="inline-flex h-9 w-9 items-center justify-center border border-[color-mix(in_srgb,var(--nm-cream)_22%,transparent)] bg-transparent text-[var(--nm-cream)] lg:hidden"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M2 4h12M2 8h12M2 12h12" />
            </svg>
          </button>
        </div>
    </Mast>

    <div
      id="nm-mobile-nav"
      class="fixed inset-0 z-[100] hidden flex-col"
      style="background: var(--nm-deep); color: var(--nm-cream)"
      role="dialog"
      aria-modal="true"
      aria-label="Site navigation"
    >
      <div class="mast">
        <a class="brand" href="/">Noemium</a>
        <button
          id="nm-nav-close"
          type="button"
          aria-label="Close menu"
          class="border border-[color-mix(in_srgb,var(--nm-cream)_22%,transparent)] bg-transparent p-2"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 3l10 10M13 3L3 13" />
          </svg>
        </button>
      </div>
      <nav class="drawer-nav flex-1 overflow-y-auto px-[var(--nm-page-x)] py-6">
        <p class="kicker">Doors</p>
        <a href="/map/" aria-current={path.startsWith('/map') ? 'page' : undefined}>Map</a>
        <a href="/autopsy/" aria-current={path.startsWith('/autopsy') ? 'page' : undefined}>Autopsy</a>
        <a href="/signals/" aria-current={path.startsWith('/signals') ? 'page' : undefined}>Signals</a>
        <a href="/reference/" aria-current={path.startsWith('/reference') ? 'page' : undefined}>Catalog</a>
        <a href="/method/" aria-current={path.startsWith('/method') ? 'page' : undefined}>Method</a>
        <p class="kicker">Catalogue</p>
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={navCurrent(item.href) ? 'page' : undefined}>
              {item.name}
            </a>
          ))
        }
        <button type="button" data-nm-palette>Search</button>
      </nav>
    </div>

    <main id="nm-main" class="mx-auto w-full max-w-7xl flex-1 px-[var(--nm-page-x)] pb-20">
      <slot />
    </main>

    <footer class="mt-20 border-t border-[color-mix(in_srgb,var(--nm-ink)_12%,transparent)]">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-6 py-10">
        <p class="font-mono text-[14px] tracking-wide text-ink">
          Code <span class="text-accent">MIT</span> · Content <span class="text-accent">CC BY 4.0</span>
        </p>
        <p class="w-full font-mono text-[13px] text-ink-dim">
          Affiliate links are declared. They never move a verdict.
        </p>
        <p class="flex flex-wrap items-center gap-5 font-mono text-[14px] text-ink-dim">
          <a href="https://github.com/SaneSanders/noemium" class="hover:text-ink" rel="noopener">GitHub</a>
          <a href="/about/" class="hover:text-ink">About</a>
          <a href="/quiz/" class="hover:text-ink">Quiz</a>
          <a href="/alternatives/" class="hover:text-ink">Alternatives</a>
          <a href="/pack/" class="hover:text-ink">Inbox Desk</a>
          <a href="/method/" class="hover:text-ink">Method</a>
          <a href="/contribute/" class="hover:text-ink">Contribute</a>
          <a href="/status/" class="hover:text-ink">Status</a>
          <a href="/kit/" class="hover:text-ink">Kit</a>
          <a href="/prices/" class="hover:text-ink">Prices</a>
          <a href="/free/" class="hover:text-ink">Free</a>
          <a href="/plans/" class="hover:text-ink">Plans</a>
          <a href="/mcp/" class="hover:text-ink">MCP</a>
          <a href="/money/" class="hover:text-ink">Money</a>
          <a href="/why/" class="hover:text-ink">Why</a>
          <a href="/search/" class="hover:text-ink">Search</a>
          <a href="/graveyard/" class="hover:text-ink">Graveyard</a>
          <a href="/rss.xml" class="hover:text-ink">RSS</a>
          <a href="/llms.txt" class="hover:text-ink">llms.txt</a>
          <a href="/api/tools.json" class="hover:text-ink">tools.json</a>
          <a href="https://x.com/whysanesanders" class="hover:text-ink" rel="noopener">@whysanesanders</a>
        </p>
        <span class="font-display text-[16px] font-medium uppercase tracking-[0.28em]">Noemium</span>
      </div>
    </footer>

    <CommandPalette client:idle transition:persist />
    <ProofDrawer client:idle transition:persist />

    <script>
      // Mobile nav overlay. Delegated listeners bind once and survive view
      // transitions (the document persists; the header markup is swapped).
      function focusableElements(root: HTMLElement): HTMLElement[] {
        return Array.from(
          root.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), input, textarea, select, details, [tabindex]:not([tabindex="-1"])'
          )
        ).filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);
      }

      function setMobileNav(open: boolean) {
        const overlay = document.getElementById('nm-mobile-nav');
        const trigger = document.getElementById('nm-nav-open');
        if (!overlay) return;
        overlay.classList.toggle('hidden', !open);
        overlay.classList.toggle('flex', open);
        trigger?.setAttribute('aria-expanded', String(open));
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) {
          const first = focusableElements(overlay as HTMLElement)[0];
          requestAnimationFrame(() => first?.focus());
        } else {
          requestAnimationFrame(() => trigger?.focus());
        }
      }

      function syncThemeToggle() {
        const btn = document.getElementById('nm-theme-toggle');
        if (!btn) return;
        const light = document.documentElement.dataset.theme === 'light';
        btn.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
        btn.setAttribute('aria-pressed', String(light));
      }
      syncThemeToggle();
      document.addEventListener('astro:page-load', syncThemeToggle);
      document.addEventListener('click', (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        if (t.closest('#nm-theme-toggle')) {
          const root = document.documentElement;
          const light = root.dataset.theme === 'light';
          if (light) delete root.dataset.theme;
          else root.dataset.theme = 'light';
          try {
            localStorage.setItem('nm-theme', light ? 'dark' : 'light');
          } catch {}
          syncThemeToggle();
        } else if (t.closest('[data-nm-palette]')) {
          setMobileNav(false);
          window.dispatchEvent(new CustomEvent('nm:palette:open'));
        } else if (t.closest('#nm-nav-open')) setMobileNav(true);
        else if (t.closest('#nm-nav-close') || t.closest('#nm-mobile-nav a')) setMobileNav(false);
      });
      document.addEventListener('keydown', (e) => {
        const overlay = document.getElementById('nm-mobile-nav');
        const open = overlay !== null && !overlay.classList.contains('hidden');
        if (e.key === 'Escape') {
          if (open) {
            e.preventDefault();
            setMobileNav(false);
          }
          return;
        }
        if (e.key !== 'Tab' || !open) return;
        const focusables = focusableElements(overlay as HTMLElement);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      });
      document.addEventListener('astro:before-swap', () => setMobileNav(false));
    </script>
  </body>
</html>
