---
import Base from '../../layouts/Base.astro';

const files = [
  { href: '/pack/inbox-desk/README.md', name: 'README.md', note: 'What the pack is' },
  { href: '/pack/inbox-desk/SOP.md', name: 'SOP.md', note: 'Escalation, silence, the route between roles' },
  { href: '/pack/inbox-desk/profiles/inbox.md', name: 'profiles/inbox.md', note: 'Classify, extract, one draft or needs_human' },
  { href: '/pack/inbox-desk/profiles/qual.md', name: 'profiles/qual.md', note: '3–5 questions, then stop. No money.' },
  { href: '/pack/inbox-desk/profiles/closer-lite.md', name: 'profiles/closer-lite.md', note: 'Warm lead → slot + prepaid draft' },
];

const roles = [
  {
    name: 'Inbox',
    file: '/pack/inbox-desk/profiles/inbox.md',
    job: 'Classify the incoming message and extract facts. Return one short draft, or needs_human. Not both.',
  },
  {
    name: 'Qual',
    file: '/pack/inbox-desk/profiles/qual.md',
    job: 'Ask 3–5 questions, then stop at ready_to_book, dead, or escalate. Does not collect money.',
  },
  {
    name: 'Closer-lite',
    file: '/pack/inbox-desk/profiles/closer-lite.md',
    job: 'Warm lead only: one slot and a prepaid wording. If the operator did not give a sum, print a placeholder.',
  },
];

const notThis = [
  'Send the message. The agent drafts. A human sends.',
  'Collect money. Qual never asks for a transfer. Closer-lite only drafts the wording.',
  'Give legal or medical advice.',
  'Talk to minors, or handle someone else’s data.',
  'Answer spam, an empty “hi”, or anyone already marked dead.',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: 'Inbox Desk',
  url: new URL('/pack/', Astro.site).href,
  description:
    'A free-to-read prompt pack for local-service inboxes. Three agent profiles and an SOP. The agent drafts. A human sends.',
  inLanguage: 'en',
  isAccessibleForFree: true,
  hasPart: files.map((file) => ({
    '@type': 'CreativeWork',
    name: file.name,
    url: new URL(file.href, Astro.site).href,
    encodingFormat: 'text/markdown',
    inLanguage: 'en',
  })),
};
---

<Base
  title="Inbox Desk"
  description="A free-to-read prompt pack for local-service inboxes. Three agent profiles and an SOP. The agent drafts. A human sends."
>
  <article class="pb-16">
    <header class="grid gap-10 py-14 md:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
      <div>
        <p class="flex items-center gap-3 font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
          <span aria-hidden="true" class="inline-block h-0.5 w-9 bg-accent"></span>
          Studio pack · free to read
        </p>
        <h1 class="text-shadow-section mt-6 font-display text-5xl leading-[0.98] font-black tracking-tight uppercase md:text-7xl">
          Inbox Desk
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed font-medium text-ink opacity-75">
          Three operator profiles and an SOP for local-service inboxes. The agent
          drafts. A human sends. Nothing here sends itself.
        </p>
        <p class="mt-8">
          <a href="#pack-files" class="nm-btn nm-btn-outline">Read the markdown</a>
        </p>
      </div>

      <aside class="nm-card p-5 md:p-6" aria-label="Routing slip">
        <p class="font-mono text-[11px] font-bold tracking-[0.14em] text-ink-dim uppercase">
          Routing slip · draft only
        </p>
        <ul class="mt-4 list-none space-y-3">
          {
            roles.map((role) => (
              <li class="border-t-[1.5px] border-line-soft pt-3 first:border-t-0 first:pt-0">
                <p class="font-display text-xl font-extrabold tracking-tight uppercase">{role.name}</p>
                <p class="mt-1 text-[14px] leading-relaxed text-ink opacity-70">{role.job}</p>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 border-t-[1.5px] border-ink pt-4 font-mono text-[12px] tracking-[0.08em] text-accent uppercase">
          Human sends
        </p>
      </aside>
    </header>

    <section class="max-w-2xl">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">What it is</h2>
      <p class="mt-4 text-[15px] leading-relaxed text-ink opacity-80">
        Inbox Desk is markdown you paste into a chat you already use. It is a studio
        SKU page, not a catalog tool card: no verdict, no floor slot, no hosted inbox.
        The files are English, like the rest of noemium.com.
      </p>
    </section>

    <section class="mt-12 max-w-2xl">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Who it’s for</h2>
      <p class="mt-4 text-[15px] leading-relaxed text-ink opacity-80">
        Local-service operators — detailing shops, clinics, kitchens, studios — who
        already answer first contact by hand and want a draft waiting. If you need an
        agent that talks to customers on its own, this is the wrong pack.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="text-shadow-section font-display text-4xl leading-[0.98] font-black tracking-tight uppercase md:text-5xl">
        What’s in the box
      </h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink opacity-75">
        Three roles, one SOP. Do not mix roles in a single reply. New unknown mail
        always goes through Inbox first.
      </p>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          roles.map((role) => (
            <a href={role.file} class="nm-card nm-card-hover flex h-full flex-col p-6">
              <p class="font-mono text-[11px] font-bold tracking-[0.12em] text-accent uppercase">Profile</p>
              <h3 class="mt-3 font-display text-2xl font-extrabold tracking-tight uppercase">{role.name}</h3>
              <p class="mt-3 flex-1 text-[15px] leading-relaxed text-ink opacity-75">{role.job}</p>
              <p class="mt-6 font-mono text-[12px] text-accent">{role.file.replace('/pack/inbox-desk/', '')} →</p>
            </a>
          ))
        }
      </div>
    </section>

    <section class="nm-card mt-14 max-w-3xl p-6 md:p-8">
      <p class="font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
        <span class="nm-num">15</span> min · then a human
      </p>
      <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight uppercase">Set it up</h2>
      <ol class="mt-5 list-decimal space-y-3 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-accent">
        <li>Open any chat that will take a system prompt or a pasted brief.</li>
        <li>
          Read <a href="/pack/inbox-desk/SOP.md" class="text-accent hover:underline">SOP.md</a>. Keep it next to the profile.
        </li>
        <li>Paste one profile. Fill the operator facts the file asks for — services, windows, what to print when there is no sum.</li>
        <li>Paste the incoming message. Read the draft. Send it yourself, or don’t.</li>
      </ol>
    </section>

    <section class="mt-14 max-w-3xl rounded-lg border-[1.5px] border-dashed border-ink p-6 md:p-8">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">What it will not do</h2>
      <ul class="mt-4 list-disc space-y-3 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-verdict-skip">
        {notThis.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section id="pack-files" class="mt-16">
      <h2 class="text-shadow-section font-display text-4xl leading-[0.98] font-black tracking-tight uppercase md:text-5xl">
        The files
      </h2>
      <p class="mt-4 max-w-2xl text-[15px] leading-relaxed text-ink opacity-75">
        Raw markdown, readable and downloadable. No storefront. No price field.
      </p>
      <ul class="mt-8 border-y-[1.5px] border-ink">
        {
          files.map((file) => (
            <li class="border-b-[1.5px] border-line-soft last:border-b-0">
              <a href={file.href} class="flex flex-wrap items-baseline justify-between gap-3 py-4 hover:text-accent">
                <span class="font-mono text-[14px] font-medium">{file.name}</span>
                <span class="text-[14px] text-ink-dim">{file.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} is:inline />
</Base>
