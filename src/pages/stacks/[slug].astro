---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  const stacks = await getCollection('stacks');
  return stacks.map((stack) => ({ params: { slug: stack.id }, props: { stack } }));
}) satisfies GetStaticPaths;

const { stack } = Astro.props;
const s = stack.data;
const { Content } = await render(stack);

const toolsById = new Map((await getCollection('tools')).map((t) => [t.id, t]));
const stackTools = s.tools
  .map((slug) => toolsById.get(slug))
  .filter((t) => t !== undefined);

const pageUrl = new URL(`/stacks/${stack.id}`, Astro.site).href;
const markdown = [
  `# ${s.title}`,
  '',
  `$${s.monthly_cost_usd}/mo · difficulty: ${s.difficulty}`,
  '',
  '| Tool | Pricing |',
  '| --- | --- |',
  ...stackTools.map(
    (t) => `| [${t.data.name}](${t.data.url}) | ${t.data.price_note ?? t.data.pricing} |`,
  ),
  '',
  `via ${pageUrl}`,
].join('\n');

const hostname = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};
---

<Base title={s.title} description={s.use_case} ogImage={`/og/stacks/${stack.id}.png`}>
  <article class="py-14 md:py-20">
    <p class="flex items-center gap-3 font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
      <span aria-hidden="true" class="inline-block h-0.5 w-9 bg-accent"></span>
      <a href="/stacks" class="hover:underline">Stacks</a>
      <span class="text-ink-dim">/ {stack.id}</span>
    </p>
    <h1 class="text-shadow-section mt-6 max-w-4xl font-display text-5xl leading-[0.98] font-black tracking-tight uppercase md:text-7xl">{s.title}</h1>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed font-medium text-ink opacity-80">{s.use_case}</p>
    <p class="mt-5 flex flex-wrap items-center gap-3 font-mono text-[13px] text-ink-dim">
      <span>observed by @{s.observed_by}</span>
      <span class="nm-verified">Verified {s.last_verified}</span>
    </p>

    <div class="nm-card mt-10 flex flex-wrap items-end gap-x-10 gap-y-5 p-6 md:p-8">
      <p>
        <span class="nm-num text-6xl leading-none font-bold text-accent md:text-7xl">${s.monthly_cost_usd}</span>
        <span class="nm-num ml-2 text-lg text-ink-dim">/mo</span>
      </p>
      <p class="pb-2 font-mono text-xs tracking-[0.14em] text-ink-dim uppercase">
        difficulty: {s.difficulty}
      </p>
      <p class="pb-1">
        <button
          id="copy-markdown"
          type="button"
          class="nm-btn nm-btn-outline"
        >
          Copy as markdown
        </button>
        <span
          id="copied-stamp"
          class="nm-stamp ml-3 hidden rounded-sm border-[1.5px] border-verdict-ship px-2 py-0.5 font-mono text-xs font-medium tracking-widest text-verdict-ship uppercase"
        >
          copied
        </span>
      </p>
    </div>

    <section class="mt-10">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">The components</h2>
      <p class="mt-3 flex flex-wrap gap-2">
        {
          stackTools.map((t) => (
            <a
              href={`/tools/${t.id}`}
              class="rounded-md border-[1.5px] border-ink px-3 py-1.5 font-mono text-[13px] font-medium text-ink transition-all duration-100 hover:-translate-0.5 hover:border-accent hover:text-accent hover:shadow-hard-sm"
            >
              {t.data.name}
            </a>
          ))
        }
      </p>
    </section>

    <div class="nm-prose mt-8 max-w-3xl">
      <Content />
    </div>

    <section class="mt-10">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Sources</h2>
      <ol class="mt-4 space-y-2">
        {
          s.receipts.map((r, i) => (
            <li class="flex items-baseline gap-2 font-mono text-[13px]">
              <sup class="font-bold text-accent">{i + 1}</sup>
              <a href={r} class="text-accent hover:underline" rel="noopener">
                {hostname(r)}
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <p class="mt-10">
      <a
        href={`https://github.com/SaneSanders/noemium/edit/main/src/content/stacks/${stack.id}.md`}
        class="nm-btn nm-btn-outline"
        rel="noopener"
      >
        Edit this page on GitHub
      </a>
    </p>
  </article>

  <template id="stack-markdown">{markdown}</template>

  <script>
    const button = document.getElementById('copy-markdown');
    const stamp = document.getElementById('copied-stamp');
    const tpl = document.getElementById('stack-markdown') as HTMLTemplateElement | null;
    button?.addEventListener('click', async () => {
      const md = tpl?.content.textContent ?? '';
      await navigator.clipboard.writeText(md);
      stamp?.classList.remove('hidden');
      setTimeout(() => stamp?.classList.add('hidden'), 1500);
    });
  </script>
</Base>
