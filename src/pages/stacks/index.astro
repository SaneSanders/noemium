---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const stacks = await getCollection('stacks');
---

<Base
  title="Stacks"
  description="Copy-pasteable AI stacks with real monthly costs. Every recipe names its tools, its cost and its receipts."
>
  <SectionHeader
    title="Stacks"
    sub="Whole recipes, not ingredients: each stack lists its tools, its real monthly cost and the receipts behind it. Copy one, adapt it, ship."
  />
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      stacks.map((stack) => (
        <a
          href={`/stacks/${stack.id}`}
          class="nm-card nm-card-hover group flex flex-col p-6"
        >
          <div class="flex items-start justify-between gap-3">
            <span class="rounded-sm border-[1.5px] border-ink px-1.5 py-0.5 font-mono text-[10px] font-medium tracking-[0.12em] text-ink uppercase">
              {stack.data.difficulty}
            </span>
            <span class="nm-verified">Verified {stack.data.last_verified}</span>
          </div>
          <h3 class="mt-4 font-display text-2xl font-extrabold tracking-tight group-hover:text-accent">
            {stack.data.title}
          </h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink opacity-75">{stack.data.use_case}</p>
          <div class="mt-6 flex items-end justify-between gap-3 border-t-[1.5px] border-line-soft pt-4">
            <p>
              <span class="nm-num text-3xl font-bold text-accent">${stack.data.monthly_cost_usd}</span>
              <span class="nm-num ml-1 text-sm text-ink-dim">/mo</span>
            </p>
            <span class="font-mono text-xs text-ink-dim">{stack.data.tools.length} tools</span>
          </div>
        </a>
      ))
    }
  </div>
</Base>
