---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import LogoTile from '../../components/LogoTile.astro';
import { plural } from '../../lib/shelf';

const stacks = await getCollection('stacks');
const byId = new Map(stacks.map((s) => [s.id, s]));
const toolNames = new Map(
  (await getCollection('tools')).map((t) => [t.id, t.data.name]),
);
---

<Base
  title="Stacks"
  description="Copy-pasteable AI stacks with real monthly costs. Every recipe names its tools, its cost and its receipts."
>
  <SectionHeader
    title="Stacks"
    sub="Whole recipes, not ingredients: each stack lists its tools, its real monthly cost and the receipts behind it. Copy one, adapt it, ship."
  />
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {
      stacks.map((stack) => (
        <a
          href={`/stacks/${stack.id}/`}
          class="nm-card nm-card-hover group flex flex-col p-6"
        >
          <div class="flex items-start justify-between gap-3">
            <span class="rounded-sm border-[1.5px] border-ink px-2 py-1 font-mono text-[11px] font-medium tracking-[0.12em] text-ink uppercase">
              {stack.data.difficulty}
            </span>
            <span class="nm-verified">Verified {stack.data.last_verified}</span>
          </div>
          <h3 class="mt-4 font-display text-2xl font-medium tracking-tight group-hover:text-accent">
            {stack.data.title}
          </h3>
          <p class="mt-3 flex items-center">
            {stack.data.tools.slice(0, 5).map((slug, i) => (
              <span class:list={['relative', i > 0 && '-ml-2']}>
                <LogoTile slug={slug} name={toolNames.get(slug) ?? slug} size="sm" />
              </span>
            ))}
            {stack.data.tools.length > 5 && (
              <span class="relative -ml-1 flex h-7 min-w-7 items-center justify-center rounded-sm border-[1.5px] border-ink bg-paper px-1 font-mono text-[11px] font-bold text-ink-dim">
                +{stack.data.tools.length - 5}
              </span>
            )}
          </p>
          <p class="mt-3 line-clamp-2 min-h-[2.9em] flex-1 text-[15px] leading-relaxed text-ink opacity-75">{stack.data.use_case}</p>
          <div class="mt-6 flex items-end justify-between gap-3 border-t-[1.5px] border-line-soft pt-4">
            <p>
              <span class="nm-num text-3xl font-bold text-accent">${stack.data.monthly_cost_usd}</span>
              <span class="nm-num ml-1 text-sm text-ink-dim">/mo</span>
              {stack.data.budget && (
                <span class="mt-1 block font-mono text-[11px] font-medium tracking-wide text-ink-dim uppercase">
                  shoestring ${stack.data.budget.monthly_cost_usd}
                </span>
              )}
              {stack.data.twin &&
                byId.get(stack.data.twin.slug) &&
                byId.get(stack.data.twin.slug)!.data.monthly_cost_usd !== stack.data.budget?.monthly_cost_usd && (
                <span class="mt-1 block font-mono text-[11px] font-medium tracking-wide text-ink-dim uppercase">
                  {stack.data.twin.kind} ${byId.get(stack.data.twin.slug)!.data.monthly_cost_usd}
                </span>
              )}
            </p>
            <span class="font-mono text-[13px] text-ink-dim">{plural(stack.data.tools.length, 'tool')}</span>
          </div>
        </a>
      ))
    }
  </div>
</Base>
