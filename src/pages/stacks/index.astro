---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';

const stacks = await getCollection('stacks');
---

<Base
  title="Stacks"
  description="Copy-pasteable AI stacks with real monthly costs. Every recipe names its tools, its cost and its receipts."
>
  <SectionHeader
    index="02"
    title="Stacks"
    sub="Whole recipes, not ingredients: each stack lists its tools, its real monthly cost and the receipts behind it. Copy one, adapt it, ship."
  />
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      stacks.map((stack) => (
        <a
          href={`/stacks/${stack.id}`}
          class="group flex flex-col rounded-md border border-line bg-panel p-5 transition-colors duration-200 hover:border-shift-near hover:bg-raised"
        >
          <h3 class="font-display text-2xl leading-snug group-hover:text-shift-near">
            {stack.data.title}
          </h3>
          <p class="mt-2 flex-1 text-sm text-ink-dim">{stack.data.use_case}</p>
          <p class="mt-6">
            <span class="nm-num text-3xl text-ink">${stack.data.monthly_cost_usd}</span>
            <span class="nm-num ml-1 text-sm text-ink-dim">/mo</span>
          </p>
          <p class="mt-3 flex items-center justify-between font-mono text-xs text-ink-dim">
            <span class="rounded-sm border border-line px-1.5 py-0.5 tracking-widest uppercase">
              {stack.data.difficulty}
            </span>
            <span>{stack.data.tools.length} tools</span>
          </p>
        </a>
      ))
    }
  </div>
</Base>
