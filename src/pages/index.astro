---
import { getCollection } from 'astro:content';
import Cover from '../layouts/Cover.astro';
import CoverOut from '../components/CoverOut.astro';

const [tools, models, stacks] = await Promise.all([
  getCollection('tools'),
  getCollection('models'),
  getCollection('stacks'),
]);
const countsLine = `${tools.length} tools · ${models.length} models · ${stacks.length} stacks`;

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'Noemium',
      url: 'https://noemium.com/',
      description:
        'An open, auditable catalog of AI tools, stacks and models. Verdicts with receipts, prices with dates.',
    },
    {
      '@type': 'Organization',
      name: 'Noemium',
      url: 'https://noemium.com/',
      logo: 'https://noemium.com/apple-touch-icon.png',
      sameAs: [
        'https://github.com/SaneSanders/noemium',
        'https://x.com/noemiumai',
        'https://x.com/whysanesanders',
      ],
    },
  ],
};
---

<Cover
  title="the map of the AI world"
  description="Bring the frontier in. The map of the AI world, and a verdict on the stack you already run."
  page="home"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </Fragment>
  <section class="hero">
    <div class="moon"></div>
    <div class="ground"></div>
    <h1 class="punch">Bring<br />the frontier<br /><i>in.</i></h1>
    <img
      class="nema"
      src="/nema-final4-cut.png"
      alt="Nema"
      width="1408"
      height="1408"
      fetchpriority="high"
      decoding="async"
    />
    <div class="foot">
      <p>The map of the AI world — {countsLine}. Verdicts with receipts, prices with dates.</p>
      <div class="foot-end">
        <nav class="foot-doors" aria-label="Start here">
          <a href="/map/">Enter the map →</a>
          <a href="/reference/">Catalog →</a>
        </nav>
        <CoverOut />
      </div>
    </div>
  </section>
</Cover>
