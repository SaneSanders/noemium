---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Base
  title="About"
  description="Noemium is an open catalog for picking AI tools without getting played. Every recommendation is a public PR."
>
  <SectionHeader title="About" />

  <article class="max-w-2xl space-y-5 pb-16 text-[17px] leading-relaxed">
    <p>
      Open catalog of AI tools, stacks and models. No source, no number. Every card is a YAML file.
      Wrong price? Open a PR.
    </p>
    <p>
      No stars. No paid placements. Affiliates are declared.
      <a href="/refusals/" class="text-accent hover:underline">Refusal ledger</a>.
    </p>
    <p class="font-mono text-[14px] text-ink-dim">
      <a href="/method/" class="text-accent hover:underline">Method</a>
      <span class="mx-2" aria-hidden="true">·</span>
      <a href="/contribute/" class="text-accent hover:underline">Contribute</a>
      <span class="mx-2" aria-hidden="true">·</span>
      <a href="https://github.com/SaneSanders/noemium" class="text-accent hover:underline" rel="noopener">
        GitHub
      </a>
    </p>
  </article>
</Base>
