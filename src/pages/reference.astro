---
import { getCollection } from 'astro:content';
import Cover from '../layouts/Cover.astro';
import { plural } from '../lib/shelf';

const [tools, models, stacks, agents, jobs, graveyard, skills] = await Promise.all([
  getCollection('tools'),
  getCollection('models'),
  getCollection('stacks'),
  getCollection('agents'),
  getCollection('jobs'),
  getCollection('graveyard'),
  getCollection('skills'),
]);

const counts = {
  tools: tools.length,
  models: models.length,
  stacks: stacks.length,
  agents: agents.length,
  jobs: jobs.length,
  graveyard: graveyard.length,
  skills: skills.length,
};
---

<Cover
  title="Reference"
  description="The catalogue is still here. Cards, prices, verdicts and URLs are unchanged."
  page="reference"
>
  <div class="cover-doc">
    <section class="cover-lede">
      <h1>Catalog</h1>
    </section>
    <div class="cover-doors">
      <a class="cover-door" href="/tools/"><b>Tools</b><span>{plural(counts.tools, 'tool')} · verdicts and prices</span></a>
      <a class="cover-door" href="/models/"><b>Models</b><span>{plural(counts.models, 'model')} · prices and sunsets</span></a>
      <a class="cover-door" href="/stacks/"><b>Stacks</b><span>{plural(counts.stacks, 'stack')} · recipes with a cheaper cut</span></a>
      <a class="cover-door" href="/agents/"><b>Agents</b><span>{plural(counts.agents, 'agent')} · field guide</span></a>
      <a class="cover-door" href="/skills/"><b>Skills</b><span>{plural(counts.skills, 'skill')} · installable, not a scrape</span></a>
      <a class="cover-door" href="/jobs/"><b>Jobs</b><span>{plural(counts.jobs, 'job')} · one job, one pick</span></a>
      <a class="cover-door" href="/graveyard/"><b>Graveyard</b><span>{plural(counts.graveyard, 'grave')} · dead, with a receipt</span></a>
      <a class="cover-door" href="/changelog/"><b>Changelog</b><span>What we wrote this week</span></a>
      <a class="cover-door" href="/prices/"><b>Prices</b><span>Git, not a ticker</span></a>
      <a class="cover-door" href="/free/"><b>Free</b><span>Free, self-host, bait</span></a>
      <a class="cover-door" href="/plans/"><b>Plans</b><span>Seat dollars versus API list</span></a>
      <a class="cover-door" href="/mcp/"><b>MCP</b><span>Servers with a verdict</span></a>
      <a class="cover-door" href="/benchmarks/"><b>Benchmarks</b><span>Who ran the score</span></a>
      <a class="cover-door" href="/kit/"><b>Kit</b><span>A set in a URL. Not a budget.</span></a>
      <a class="cover-door" href="/pack/"><b>Inbox Desk</b><span>Prompt pack</span></a>
      <a class="cover-door" href="/alternatives/"><b>Alternatives</b><span>Same job, different pick</span></a>
    </div>
  </div>
</Cover>
