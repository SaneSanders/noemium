---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { collectDeaths, HORIZON_DAYS, type DeathKind } from '../lib/deaths';

const asOf = new Date().toISOString().slice(0, 10);
const models = await getCollection('models');
const tools = await getCollection('tools');
const graves = await getCollection('graveyard');

const { upcoming, past } = collectDeaths({
  asOf,
  models: models.map((m) => ({
    slug: m.id,
    name: m.data.name,
    retiring: m.data.retiring,
  })),
  tools: tools.map((t) => ({
    slug: t.id,
    name: t.data.name,
    limitations: t.data.limitations,
    skip_when: t.data.skip_when,
    verdict_text: t.data.verdict_text,
    price_note: t.data.price_note,
  })),
  graveyard: graves.map((g) => ({
    slug: g.id,
    name: g.data.name,
    died: g.data.died,
    cause: g.data.cause,
    succeeded_by: g.data.succeeded_by,
  })),
});

const kindLabel: Record<DeathKind, string> = {
  model: 'model',
  api: 'API',
  feature: 'feature',
  product: 'product',
  grave: 'dead',
};

function daysLabel(days: number): string {
  if (days === 0) return 'today';
  if (days === 1) return '1 day left';
  return `${days} days left`;
}

const buried = past.filter((e) => e.kind === 'grave');
---

<Base
  title="Death calendar"
  description="Upcoming AI shutdowns, retirements and sunsets in the next 90 days, plus the tools already buried in the graveyard. Dates already in the catalogue; no invented ones."
>
  <SectionHeader
    title="Death calendar"
    sub={`Dated sunsets already in the catalogue. As of ${asOf}.`}
  />

  <p class="mb-6 font-mono text-[13px] uppercase tracking-[0.08em] text-ink-dim">
    Next {HORIZON_DAYS} days
  </p>

  {
    upcoming.length === 0 ? (
      <p class="text-[17px] leading-relaxed">No dated sunsets in the next 90 days.</p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {upcoming.map((e) => (
          <article class="nm-card nm-card-hover p-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <span class="nm-sticker text-ink-dim">{kindLabel[e.kind]}</span>
                <h2 class="font-display mt-3 text-2xl font-medium tracking-tight">
                  <a href={e.href} class="hover:text-accent">{e.name}</a>
                </h2>
                <p class="mt-1 font-mono text-[13px] text-ink-dim nm-num">
                  {e.date} · {daysLabel(e.days)}
                </p>
              </div>
              <span class="font-display text-4xl font-medium tracking-tight text-accent nm-num">
                {e.days === 0 ? '0' : e.days}
              </span>
            </div>
            <p class="mt-4 text-[17px] leading-relaxed">{e.quote}</p>
            {e.migrate && (
              <p class="mt-3 font-mono text-[13px]">
                Move to{' '}
                <a href={e.migrate.href} class="font-semibold text-accent hover:underline">
                  {e.migrate.name}
                </a>
              </p>
            )}
          </article>
        ))}
      </div>
    )
  }

  <section class="mt-16">
    <p class="mb-6 font-mono text-[13px] uppercase tracking-[0.08em] text-ink-dim">
      Already buried
    </p>
    {
      buried.length === 0 ? (
        <p class="text-[17px] leading-relaxed">Nothing in the graveyard yet.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2">
          {buried.map((g) => (
            <article class="nm-card nm-card-hover p-6">
              <span class="nm-sticker text-ink-dim">{kindLabel[g.kind]}</span>
              <h2 class="font-display mt-3 text-2xl font-medium tracking-tight">
                <a href="/graveyard/" class="hover:text-accent">{g.name}</a>
              </h2>
              <p class="mt-1 font-mono text-[13px] text-ink-dim nm-num">died {g.date}</p>
              <p class="mt-4 text-[17px] leading-relaxed">{g.quote}</p>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <p class="mt-12 max-w-prose text-[15px] leading-relaxed text-ink-dim">
    Dates are pulled from the catalogue only when they sit next to a sunset verb. No
    rumours, no invented deadlines. The{' '}
    <a href="/signals/" class="text-accent hover:underline">Signals</a> page carries the
    live-status board; this page is the calendar view.
  </p>
</Base>
