---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import CompareTable from '../../islands/CompareTable';
import { COMPARE_PAIRS } from '../../data/compare-presets';

const tools = await getCollection('tools');
const byId = new Map(tools.map((t) => [t.id, t]));
const presets = COMPARE_PAIRS.map(({ a, b }) => ({
  aSlug: a,
  bSlug: b,
  a: byId.get(a)?.data,
  b: byId.get(b)?.data,
})).filter((p) => p.a && p.b);
---

<Base
  title="Compare tools"
  description="Put two to four AI tools side by side — price, free tier, OSS, API, self-host, verdict, limitations, momentum."
>
  <SectionHeader
    title="Compare"
    sub="Two to four tools, side by side. Same fields, same honesty — verdicts and limitations included."
  />

  {
    presets.length > 0 && (
      <section class="mb-10" aria-labelledby="compare-presets-heading">
        <h2
          id="compare-presets-heading"
          class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase"
        >
          Popular comparisons
        </h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {presets.map(({ aSlug, bSlug, a, b }) => (
            <a
              href={`/tools/compare/${aSlug}-vs-${bSlug}/`}
              class="nm-card nm-card-hover flex items-baseline justify-between gap-3 px-4 py-3"
            >
              <span class="font-display text-lg font-extrabold tracking-tight">
                {a!.name}
                <span class="mx-1.5 font-mono text-[11px] font-normal tracking-wider text-ink-dim uppercase">vs</span>
                {b!.name}
              </span>
              <span class="font-mono text-[10px] tracking-[0.08em] text-ink-dim uppercase">{a!.category}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <CompareTable client:load />
</Base>
