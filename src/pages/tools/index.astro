---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ToolCard from '../../components/ToolCard.astro';
import FilterBar from '../../islands/FilterBar';
import { plural } from '../../lib/shelf';

const tools = await getCollection('tools');
const data = tools
  .map((t) => ({
    slug: t.id,
    name: t.data.name,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Noemium AI tools catalog',
  itemListElement: data.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: new URL(`/tools/${t.slug}/`, Astro.site).href,
  })),
};
---

<Base
  title="Tools"
  description={`${plural(data.length, 'tool')} with signed verdicts and named limitations. No pay-to-list — every entry is a pull request you can audit.`}
>
  <SectionHeader title="Tools" sub={`${plural(data.length, 'tool')}. `}>
    <kbd
      slot="sub"
      aria-label="Press / to filter this shelf"
      class="rounded-sm border-[1.5px] border-ink bg-card px-1.5 py-0.5 font-mono text-xs text-ink"
    >
      /
    </kbd>
  </SectionHeader>
  <FilterBar client:load />
  <div id="nm-tool-grid" class="mt-5 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {tools.sort((a, b) => a.data.name.localeCompare(b.data.name)).map((tool) => <ToolCard tool={tool} />)}
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    is:inline
  />
</Base>
