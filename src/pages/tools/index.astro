---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import KbdHint from '../../components/KbdHint.astro';
import FilterBar, { type ToolRecord } from '../../islands/FilterBar';
import { logoSrc } from '../../lib/logos';
import { plural } from '../../lib/shelf';

const tools = await getCollection('tools');
const data: ToolRecord[] = tools
  .map((t) => ({
    slug: t.id,
    name: t.data.name,
    tagline: t.data.tagline,
    category: t.data.category,
    pricing: t.data.pricing,
    price_note: t.data.price_note,
    free_tier: t.data.free_tier,
    open_source: t.data.open_source,
    api: t.data.api,
    verdict: t.data.verdict,
    momentum: t.data.momentum,
    featured: t.data.featured,
    last_verified: t.data.last_verified,
    logo: logoSrc(t.id),
    observed_by: t.data.observed_by,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Noemium AI tools catalog',
  itemListElement: data.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: new URL(`/tools/${t.slug}/`, Astro.site).href,
  })),
};
---

<Base
  title="Tools"
  description={`${plural(data.length, 'tool')} with signed verdicts and named limitations. No pay-to-list — every entry is a pull request you can audit.`}
>
  <SectionHeader
    title="Catalog"
    sub={`${plural(data.length, 'tool')} with signed verdicts and named limitations. No pay-to-list — every entry is a pull request you can audit.`}
  />
  <p class="-mt-6 mb-6 font-mono text-xs text-ink-dim">
    Press <KbdHint keys="/" /> to filter this shelf. ⌘K searches the whole catalog.
  </p>
  <FilterBar client:load tools={data} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    is:inline
  />
</Base>
