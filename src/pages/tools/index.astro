---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import KbdHint from '../../components/KbdHint.astro';
import ToolCard from '../../components/ToolCard.astro';
import FilterBar from '../../islands/FilterBar';
import { plural } from '../../lib/shelf';

const tools = await getCollection('tools');
const data = tools
  .map((t) => ({
    slug: t.id,
    name: t.data.name,
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Noemium AI tools catalog',
  itemListElement: data.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: new URL(`/tools/${t.slug}/`, Astro.site).href,
  })),
};
---

<Base
  title="Tools"
  description={`${plural(data.length, 'tool')} with signed verdicts and named limitations. No pay-to-list — every entry is a pull request you can audit.`}
>
  <SectionHeader
    title="Catalog"
    sub={`${plural(data.length, 'tool')} with signed verdicts and named limitations. No pay-to-list — every entry is a pull request you can audit.`}
  />
  <p class="-mt-4 mb-8 font-mono text-xs text-ink-dim">
    Press <KbdHint keys="/" /> to filter this shelf. Cmd+K searches the whole catalog.
  </p>
  <FilterBar client:load />
  <div id="nm-tool-grid" class="mt-5 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {tools.sort((a, b) => a.data.name.localeCompare(b.data.name)).map((tool) => <ToolCard tool={tool} />)}
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    is:inline
  />
</Base>
