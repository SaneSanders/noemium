---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import ShiftArrow from '../../components/ShiftArrow.astro';
import ToolCard from '../../components/ToolCard.astro';
import VerifiedStamp from '../../components/VerifiedStamp.astro';
import CopyButton from '../../components/CopyButton.astro';
import { logoSrc } from '../../lib/logos';
import LogoTile from '../../components/LogoTile.astro';
import ToolBriefing from '../../components/ToolBriefing.astro';
import { observationMarkdown } from '../../lib/observation';
import { relatedIds, SKIP_ALTERNATIVE } from '../../lib/shelf';
import { COMPARE_PAIRS } from '../../data/compare-presets';
import changelog from '../../data/changelog.json';

export const getStaticPaths = (async () => {
  const tools = await getCollection('tools');
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}) satisfies GetStaticPaths;

const { tool } = Astro.props;
const t = tool.data;
const logo = logoSrc(tool.id);

const catalog = await getCollection('tools');
const models = await getCollection('models');
const modelNames = new Map(models.map((m) => [m.id, m.data.name]));
const relatedIdList = relatedIds(
  tool.id,
  catalog.map((x) => ({
    id: x.id,
    name: x.data.name,
    category: x.data.category,
    tagline: x.data.tagline,
    verdict: x.data.verdict,
    last_verified: x.data.last_verified,
  })),
);
const related = relatedIdList
  .map((id) => catalog.find((x) => x.id === id))
  .filter((x) => x !== undefined);
const skipPeer = SKIP_ALTERNATIVE[tool.id];
const skipPeerTool = skipPeer ? catalog.find((x) => x.id === skipPeer) : undefined;

const comparePairs = COMPARE_PAIRS.filter((p) => p.a === tool.id || p.b === tool.id)
  .map((p) => {
    const otherSlug = p.a === tool.id ? p.b : p.a;
    const other = catalog.find((x) => x.id === otherSlug);
    return other ? { slug: `${p.a}-vs-${p.b}`, otherName: other.data.name } : null;
  })
  .filter((x): x is { slug: string; otherName: string } => x !== null);

const facts: [string, string][] = [
  ['pricing', t.pricing],
  ...(t.price_note ? ([['price note', t.price_note]] as [string, string][]) : []),
  ['free tier', t.free_tier ? (t.pricing === 'paid' ? 'yes — paid to keep using' : 'yes') : 'no'],
  ['open source', t.open_source ? 'yes' : 'no'],
  ['api', t.api ? 'yes' : 'no'],
  ['self-host', t.self_host ? 'yes' : 'no'],
  ['category', t.category],
];

const hostname = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};

const archiveUrl = (url: string) => `https://web.archive.org/web/2026/${url}`;

// Declared affiliates: primary Visit goes to affiliate_url. The clean
// canonical `url` stays on the page as a secondary "without referral" link.
const declaredAffiliate = t.affiliate === 'declared' && t.affiliate_url ? t.affiliate_url : undefined;
const visitHref = declaredAffiliate ?? t.url;
const visitRel = declaredAffiliate ? 'sponsored nofollow noopener' : 'noopener';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: t.name,
  url: t.url,
  description: t.tagline,
  applicationCategory: t.category,
  dateModified: t.last_verified,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    category: t.pricing,
    description: t.price_note ?? t.pricing,
    availability:
      t.pricing === 'free'
        ? 'https://schema.org/FreeOfCharge'
        : 'https://schema.org/InStock',
  },
};

// Price trail — pricing revisions for this tool, straight from the changelog
// data (which is itself built from git history).
const trail = ((changelog as { weeks: { id: string; from: string; changed: { collection: string; slug: string; field: string; from: string | null; to: string | null }[] }[] }).weeks ?? []).flatMap((w) =>
  w.changed
    .filter((c) => c.collection === 'tools' && c.slug === tool.id && (c.field === 'pricing' || c.field === 'price note'))
    .map((c) => ({ week: w.id, date: w.from, field: c.field, from: c.from, to: c.to })),
);
const shortTrail = (v: string | null) => {
  const s = String(v ?? '—');
  return s.length > 56 ? `${s.slice(0, 53)}…` : s;
};

const briefing =
  t.strengths && t.use_for && t.skip_when
    ? { strengths: t.strengths, use_for: t.use_for, skip_when: t.skip_when }
    : null;

const disputePrompt = [
  `Fact-check this catalog entry for ${t.name} (${t.category}).`,
  `Verdict: ${t.verdict}`,
  `Verdict text: ${t.verdict_text}`,
  `Limitations:`,
  ...t.limitations.map((l) => `- ${l}`),
  `Receipts:`,
  ...t.receipts,
  `Last verified: ${t.last_verified}`,
  '',
  'Find outdated prices, wrong claims, or missing limitations. Cite primary sources (docs, pricing pages, benchmarks, model cards). Do not use marketing pages.',
].join('\n');
---

<Base title={t.name} description={t.tagline} ogImage={`/og/tools/${tool.id}.png`}>
  <link slot="head" rel="alternate" type="application/json" href={`/tools/${tool.id}.json`} />
  <article class="py-14 md:py-20">
    <p class="flex items-center gap-3 font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
      <span aria-hidden="true" class="inline-block h-0.5 w-9 bg-accent"></span>
      <a href="/tools/" class="hover:underline">Catalog</a>
      <span aria-hidden="true" class="text-ink-dim">/</span>
      <a href={`/tools/?cat=${t.category}`} class="hover:underline">{t.category}</a>
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-4">
      <LogoTile slug={tool.id} name={t.name} src={logo} size="lg" />
      <h1 class="font-display text-5xl leading-[0.98] font-medium tracking-tight md:text-7xl">{t.name}</h1>
      <VerdictBadge verdict={t.verdict} class="text-sm" />
      <ShiftArrow momentum={t.momentum} class="h-6 w-6" />
    </div>
    <p class="mt-6 max-w-2xl text-xl leading-relaxed font-medium text-ink opacity-80">{t.tagline}</p>
    <p class="mt-7 flex flex-wrap items-center gap-4">
      <a href={visitHref} class="nm-btn nm-btn-solid" rel={visitRel}>
        Visit {hostname(t.url)} →
        {
          declaredAffiliate && (
            <span class="rounded-sm border border-current px-1.5 py-0.5 font-mono text-[10px] font-medium tracking-[0.14em] uppercase">
              declared
            </span>
          )
        }
      </a>
      <CopyButton
        label="Copy observation"
        text={observationMarkdown(t, new URL(`/tools/${tool.id}/`, Astro.site).href)}
      />
      <a href={`/kit/?add=${tool.id}`} class="nm-btn nm-btn-outline">Add to kit</a>
      <CopyButton label="Dispute this verdict" text={disputePrompt} />
      <VerifiedStamp slug={tool.id} date={t.last_verified} />
    </p>
    {
      declaredAffiliate && (
        <p class="mt-4 flex flex-wrap items-center gap-3 font-mono text-xs">
          <a
            href={t.url}
            rel="noopener"
            class="border border-[color-mix(in_srgb,var(--nm-ink)_22%,transparent)] px-2 py-1 font-medium text-ink hover:border-accent"
          >
            Visit without referral
            <span class="ml-1.5 text-[10px] tracking-[0.12em] text-ink-dim uppercase">{hostname(t.url)}</span>
          </a>
          <span class="text-[11px] text-ink-dim">declared — supports Noemium</span>
        </p>
      )
    }

    <section class="nm-card mt-10 p-6 md:p-8">
      <p class="font-mono text-xs tracking-[0.14em] text-ink-dim uppercase">
        ledger entry · observed by @{t.observed_by}
      </p>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed">{t.verdict_text}</p>
      {
        t.verdict === 'skip' && skipPeerTool && (
          <p class="mt-4 font-mono text-[13px] text-ink-dim">
            Skip this for the same job — try{' '}
            <a href={`/tools/${skipPeerTool.id}/`} class="text-accent hover:underline">
              {skipPeerTool.data.name}
            </a>
            .
          </p>
        )
      }
    </section>

    {
      briefing && (
        <ToolBriefing
          strengths={briefing.strengths}
          limitations={t.limitations}
          use_for={briefing.use_for}
          skip_when={briefing.skip_when}
        />
      )
    }

    {
      (t.verdict === 'ship' || t.verdict === 'situational') && (
        <section class="nm-card mt-10 p-6 md:p-8">
          <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Buy-check</h2>
          <p class="mt-2 max-w-2xl font-mono text-[12px] leading-relaxed text-ink-dim">
            90-second checklist before checkout.
          </p>
          <ul class="mt-5 space-y-3 text-[15px] leading-relaxed">
            <li class="flex gap-3">
              <span class="font-mono text-accent">·</span>
              <span>
                <span class="font-semibold">Price</span> — {t.pricing}
                {t.price_note && <span>, {t.price_note}</span>} as of {t.last_verified}. Open the pricing page, not a screenshot.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="font-mono text-accent">·</span>
              <span>
                <span class="font-semibold">Free tier</span> —{' '}
                {t.free_tier
                  ? 'Free tier exists — burn it first.'
                  : 'No free tier — the trial clock starts at checkout.'}
              </span>
            </li>
            <li class="flex gap-3">
              <span class="font-mono text-accent">·</span>
              <span>
                <span class="font-semibold">Cancel fallout</span> — What happens to your data/projects on cancel — check the ToS, not the FAQ.
              </span>
            </li>
            <li class="flex gap-3">
              <span class="font-mono text-accent">·</span>
              <span>
                <span class="font-semibold">Seat math</span> — Per-seat pricing multiplies quietly. Count seats before the annual plan.
              </span>
            </li>
            {briefing && briefing.skip_when.length > 0 && (
              <li class="flex gap-3">
                <span class="font-mono text-accent">·</span>
                <span>
                  <span class="font-semibold">Who skips it</span> — Also skipped when: {briefing.skip_when.slice(0, 2).join('; ')}.
                </span>
              </li>
            )}
            {t.affiliate === 'declared' && (
              <li class="flex gap-3">
                <span class="font-mono text-accent">·</span>
                <span>
                  <span class="font-semibold">Money link</span> — Our Visit link is affiliate — declared, verdict unaffected.
                </span>
              </li>
            )}
          </ul>
        </section>
      )
    }

    <section class="mt-8">
      <h2 class="flex items-baseline justify-between font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">
        <span>
          Price trail
          {trail.length > 0 ? ` — ${trail.length} revision${trail.length === 1 ? '' : 's'}` : ''}
        </span>
        <a href="/changelog/" class="text-accent normal-case hover:underline">
          changelog →
        </a>
      </h2>
      {
        trail.length > 0 ? (
          <ul class="mt-4 space-y-2">
            {trail.slice(-3).map((e) => (
              <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 font-mono text-[13px]" title={`${e.from ?? ''} → ${e.to ?? ''}`}>
                <span class="text-ink-dim">{e.week}</span>
                <span class="nm-num">
                  <span class="text-ink-dim line-through">{shortTrail(e.from)}</span>
                  <span class="mx-2" aria-hidden="true">→</span>
                  <span class="font-bold text-accent">{shortTrail(e.to)}</span>
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 max-w-2xl font-mono text-[13px] leading-relaxed text-ink-dim">
            No pricing field has moved in the git changelog since tracking started. That is not a
            live vendor ticker — it is the history of this repo.
          </p>
        )
      }
    </section>

    <div class="mt-10 grid gap-10 lg:grid-cols-2">
      {
        !briefing && (
          <section>
            <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Known limitations</h2>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-verdict-skip">
              {t.limitations.map((l) => <li>{l}</li>)}
            </ul>
          </section>
        )
      }

      <section class:list={[briefing && 'lg:col-span-2']}>
        <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Facts</h2>
        <dl class="nm-card mt-4 grid grid-cols-2 gap-x-6 gap-y-4 p-6 sm:grid-cols-3">
          {facts.map(([k, v]) => (
            <div>
              <dt class="font-mono text-xs tracking-[0.12em] text-ink-dim uppercase">{k}</dt>
              <dd class="nm-num mt-1 text-[15px] font-medium">
                {v}
                {k === 'pricing' && t.receipts.length > 0 && (
                  <sup class="ml-0.5 font-mono text-[11px] text-accent">1</sup>
                )}
              </dd>
            </div>
          ))}
          {
            (t.models_used?.length || t.model_routing) && (
              <div>
                <dt class="font-mono text-xs tracking-[0.12em] text-ink-dim uppercase">Models</dt>
                <dd class="mt-1 text-[15px] font-medium">
                  {t.models_used && t.models_used.length > 0 && (
                    <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      {t.models_used.map((slug) => (
                        <a href={`/models/#${slug}`} class="text-accent hover:underline">
                          {modelNames.get(slug) ?? slug}
                        </a>
                      ))}
                    </span>
                  )}
                  {t.model_routing && (
                    <span
                      class:list={[
                        'inline-block rounded-sm border-[1.5px] px-1.5 py-0.5 font-mono text-[11px] font-medium tracking-[0.08em] uppercase',
                        t.model_routing === 'byok'
                          ? 'border-accent text-accent'
                          : 'border-ink text-ink-dim',
                      ]}
                    >
                      {t.model_routing === 'byok' ? 'BYOK' : t.model_routing}
                    </span>
                  )}
                </dd>
              </div>
            )
          }
        </dl>
        {
          t.data_sensitivity && (
            <p class="mt-5 font-mono text-[13px] text-ink-dim">
              Data: trains on inputs {t.data_sensitivity.trains_on_inputs}
              {t.data_sensitivity.eu_region !== undefined && (
                <span> · EU region {t.data_sensitivity.eu_region}</span>
              )}
              {t.data_sensitivity.local_processing !== undefined && (
                <span> · local processing {t.data_sensitivity.local_processing ? 'yes' : 'no'}</span>
              )}
            </p>
          )
        }
      </section>
    </div>

    <section class="mt-10">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Sources</h2>
      <ol class="mt-4 space-y-2">
        {t.receipts.map((r, i) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[13px]">
            <sup class="font-bold text-accent">{i + 1}</sup>
            <a href={r} class="text-accent hover:underline" rel="noopener">
              {hostname(r)}
              <span class="text-ink-dim">{new URL(r).pathname === '/' ? '' : new URL(r).pathname}</span>
            </a>
            <a href={archiveUrl(r)} class="text-ink-dim hover:text-accent" rel="noopener">
              [snapshot]
            </a>
          </li>
        ))}
      </ol>
      <p class="mt-3 font-mono text-[11px] leading-relaxed text-ink-dim">
        If we can't show the source, we don't print the number.
      </p>
    </section>

    <p class="mt-10">
      <a
        href={`https://github.com/SaneSanders/noemium/edit/main/src/content/tools/${tool.id}.yaml`}
        class="nm-btn nm-btn-outline"
        rel="noopener"
      >
        Edit this page on GitHub
      </a>
    </p>

    {
      related.length > 0 && (
        <section class="mt-16">
          <h2 class="flex flex-wrap items-baseline justify-between gap-x-6 font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">
            <span>Similar job</span>
            <a href={`/alternatives/${tool.id}/`} class="text-accent normal-case hover:underline">
              all alternatives →
            </a>
          </h2>
          {
            comparePairs.length > 0 && (
              <p class="mt-3 font-mono text-[13px] text-ink-dim">
                Compare:
                {comparePairs.map((p, i) => (
                  <>
                    {i > 0 && <span class="mx-1.5" aria-hidden="true">·</span>}
                    <a href={`/tools/compare/${p.slug}/`} class="text-accent hover:underline">
                      {t.name} vs {p.otherName}
                    </a>
                  </>
                ))}
              </p>
            )
          }
          <div class="nm-card mt-5 overflow-x-auto">
            <table class="w-full min-w-[520px] border-collapse text-left">
              <thead>
                <tr class="border-b-[1.5px] border-ink">
                  <th class="p-3 font-mono text-[12px] font-medium tracking-[0.12em] text-ink-dim uppercase">tool</th>
                  <th class="p-3 font-mono text-[12px] font-medium tracking-[0.12em] text-ink-dim uppercase">verdict</th>
                  <th class="p-3 font-mono text-[12px] font-medium tracking-[0.12em] text-ink-dim uppercase">price</th>
                  <th class="p-3 font-mono text-[12px] font-medium tracking-[0.12em] text-ink-dim uppercase">oss</th>
                  <th class="p-3 font-mono text-[12px] font-medium tracking-[0.12em] text-ink-dim uppercase">self-host</th>
                </tr>
              </thead>
              <tbody>
                {
                  [tool, ...related].map((row) => (
                    <tr class="border-b border-line-soft last:border-b-0">
                      <th scope="row" class="p-3 text-left font-display text-[15px] font-medium tracking-tight">
                        {row.id === tool.id ? (
                          row.data.name
                        ) : (
                          <a href={`/tools/${row.id}/`} class="hover:text-accent">{row.data.name}</a>
                        )}
                      </th>
                      <td class="p-3 font-mono text-[13px] uppercase">{row.data.verdict}</td>
                      <td class="p-3 font-mono text-[13px]">{row.data.pricing}</td>
                      <td class="p-3 font-mono text-[13px]">{row.data.open_source ? 'yes' : 'no'}</td>
                      <td class="p-3 font-mono text-[13px]">{row.data.self_host ? 'yes' : 'no'}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="mt-3 font-mono text-[12px] leading-relaxed text-ink-dim">
            Facts from the catalog files — not scores you can buy. Quality and speed stay in the
            briefing, not in a fake 1–5 grid.
          </p>
          <div class="mt-5 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <ToolCard tool={r} />
            ))}
          </div>
        </section>
      )
    }
  </article>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    is:inline
  />
</Base>
