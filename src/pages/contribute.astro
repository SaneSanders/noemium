---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';

// Re-check queue: the least recently verified cards, whatever their absolute
// age — a living list, not an empty staleness filter.
const tools = await getCollection('tools');
const queue = [...tools]
  .sort((a, b) => a.data.last_verified.localeCompare(b.data.last_verified))
  .slice(0, 6);

const rules = [
  'Verdicts come from real use — ship, situational or skip must reflect something you actually built or ran, not marketing pages.',
  'At least one receipt. Link the evidence: a shipped project, a screenshot, a benchmark run. No receipt, no merge.',
  'Affiliate links are always declared. Undeclared tracking parameters fail validation.',
  'Self-promotion is allowed — with the same bar as everything else: real receipts and honest, named limitations.',
];
---

<Base
  title="Contribute"
  description="Every entry in this catalog is a pull request. Add your observation in about five minutes."
>
  <SectionHeader
    index="05"
    title="Contribute"
    sub="This catalog runs on signed field notes. If you have real, hands-on experience with an AI tool, stack or model — log it. Every entry is a PR anyone can audit."
  />

  <section class="nm-card max-w-3xl p-6 md:p-8">
    <p class="font-mono text-xs font-medium tracking-[0.14em] text-accent uppercase">
      field protocol · five minutes
    </p>
    <ol class="mt-4 list-decimal space-y-3 pl-5 marker:font-mono marker:text-accent">
      <li>
        <strong class="font-bold">Fork</strong>
        <a
          href="https://github.com/SaneSanders/noemium"
          class="ml-1 font-mono text-xs text-accent hover:underline"
          rel="noopener">SaneSanders/noemium</a
        >.
      </li>
      <li>
        <strong class="font-bold">Copy a template</strong> —
        <span class="font-mono text-xs text-ink-dim">src/content/tools/cursor.yaml</span>,
        <span class="font-mono text-xs text-ink-dim">src/content/stacks/solo-founder-saas.md</span>
        or
        <span class="font-mono text-xs text-ink-dim">src/content/models/claude-sonnet-4-5.yaml</span
        >. Rename it to a kebab-case slug.
      </li>
      <li>
        <strong class="font-bold">Fill it in from your own experience</strong> — sign it with
        your GitHub handle in <span class="font-mono text-xs text-ink-dim">observed_by</span>.
      </li>
      <li>
        <strong class="font-bold">Validate locally</strong>:
        <code class="rounded-sm border-[1.5px] border-ink bg-paper px-1.5 py-0.5 font-mono text-xs"
          >npm install && npm run validate</code
        >.
      </li>
      <li>
        <strong class="font-bold">Open a PR.</strong> The same validation runs in review.
      </li>
    </ol>
  </section>

  <section class="mt-10 max-w-3xl">
    <h2 class="font-mono text-xs font-medium tracking-[0.14em] text-ink-dim uppercase">Standing orders</h2>
    <ul class="mt-4 list-disc space-y-3 pl-5 marker:font-mono marker:text-verdict-skip">
      {rules.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <section class="nm-card mt-10 max-w-3xl p-6 md:p-8">
    <p class="font-mono text-xs font-medium tracking-[0.14em] text-accent uppercase">
      adopt a page · re-check queue
    </p>
    <p class="mt-3 text-sm leading-relaxed text-ink opacity-80">
      The least recently verified cards. Adopt one: open its file, re-check the price and the
      verdict against the vendor's own pages, update <span class="font-mono text-xs text-ink-dim">last_verified</span>
      and open a PR. Small, boring, exactly what keeps this catalog trustworthy.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        queue.map((t) => (
          <li>
            <a
              href={`https://github.com/SaneSanders/noemium/edit/main/src/content/tools/${t.id}.yaml`}
              class="nm-num inline-block rounded-sm border-[1.5px] border-ink px-2.5 py-1 text-[13px] font-bold transition-all duration-100 hover:-translate-y-0.5 hover:text-accent"
              rel="noopener"
            >
              {t.data.name}
              <span class="ml-2 font-mono text-[10px] font-normal tracking-wide text-ink-dim">{t.data.last_verified}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-10 flex flex-wrap gap-4">
    <a
      href="https://github.com/SaneSanders/noemium"
      class="nm-btn nm-btn-solid"
      rel="noopener"
    >
      Open the repository
    </a>
    <a
      href="https://github.com/SaneSanders/noemium/blob/main/CONTRIBUTING.md"
      class="nm-btn nm-btn-outline"
      rel="noopener"
    >
      Read CONTRIBUTING.md
    </a>
    <a
      href="https://github.com/SaneSanders/noemium/tree/main/src/content"
      class="nm-btn nm-btn-outline"
      rel="noopener"
    >
      Browse the templates
    </a>
  </section>
</Base>
