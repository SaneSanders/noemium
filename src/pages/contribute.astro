---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { catalogHealth } from '../lib/catalog-health';

// Re-check queue: the least recently verified cards, whatever their absolute
// age — a living list, not an empty staleness filter.
const tools = await getCollection('tools');
const queue = [...tools]
  .sort((a, b) => a.data.last_verified.localeCompare(b.data.last_verified))
  .slice(0, 6);

const asOf = new Date().toISOString().slice(0, 10);
const health = catalogHealth(
  tools.map((tool) => ({
    id: tool.id,
    name: tool.data.name,
    verdict: tool.data.verdict,
    last_verified: tool.data.last_verified,
    featured: tool.data.featured,
    receipts: tool.data.receipts,
    strengths: tool.data.strengths,
    use_for: tool.data.use_for,
    skip_when: tool.data.skip_when,
  })),
  asOf,
);
const unbriefedShip = health.shipUnbriefed.slice(0, 8);

const rules = [
  'Verdicts come from real use — ship, situational or skip must reflect something you actually built or ran, not marketing pages.',
  'Agent entries use evidence tiers. Radar is discovery-only and carries no verdict or hard cost; source-verified guides need typed primary evidence for availability, setup, requirements, pricing and security.',
  'At least one receipt. Link the evidence: a shipped project, a screenshot, a benchmark run. No receipt, no merge.',
  'Affiliate links are always declared. Undeclared tracking parameters fail validation.',
  'Self-promotion is allowed — with the same bar as everything else: real receipts and honest, named limitations.',
  'Flagship cards may add a briefing — strengths, use_for, skip_when — all three together, or none. No scores, no votes, no contributor badges.',
];
---

<Base
  title="Contribute"
  description="Every entry in this catalog is a pull request. Add your observation in about five minutes."
>
  <SectionHeader title="Contribute" sub="Every entry is a PR." />

  <section class="nm-card mb-10 max-w-3xl p-6 md:p-8">
    <p class="font-mono text-[14px] font-medium tracking-[0.08em] text-accent uppercase">
      Start by disputing
    </p>
    <p class="mt-3 text-[17px] leading-relaxed">
      Correct a receipt, a price, or a verdict. Vendors: open a{' '}
      <a
        href="https://github.com/SaneSanders/noemium/issues/new?template=vendor-challenge.md"
        class="text-accent hover:underline"
        rel="noopener"
      >Vendor challenge</a>
      {' '}or{' '}
      <a
        href="https://github.com/SaneSanders/noemium/tree/main/src/content/tools"
        class="text-accent hover:underline"
        rel="noopener"
      >edit the file</a>.
    </p>
  </section>

  <section class="nm-card max-w-3xl p-6 md:p-8">
    <p class="font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
      field protocol · five minutes
    </p>
    <ol class="mt-4 list-decimal space-y-3 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-accent">
      <li>
        <strong class="font-bold">Fork</strong>
        <a
          href="https://github.com/SaneSanders/noemium"
          class="ml-1 font-mono text-[13px] text-accent hover:underline"
          rel="noopener">SaneSanders/noemium</a
        >.
      </li>
      <li>
        <strong class="font-bold">Copy a template</strong> —
        <span class="font-mono text-[13px] text-ink-dim">src/content/tools/cursor.yaml</span>,
        <span class="font-mono text-[13px] text-ink-dim">src/content/agents/grok-bot.yaml</span>,
        <span class="font-mono text-[13px] text-ink-dim">src/content/stacks/solo-founder-saas.md</span>
        or
        <span class="font-mono text-[13px] text-ink-dim">src/content/models/claude-sonnet-5.yaml</span
        >. Rename it to a kebab-case slug.
      </li>
      <li>
        <strong class="font-bold">Fill it to the right evidence tier</strong> — strict agent guides
        need primary-source receipts for setup, cost, security and availability; untested discoveries
        belong in Radar without a verdict. Sign it with your GitHub handle in
        <span class="font-mono text-[13px] text-ink-dim">observed_by</span>.
      </li>
      <li>
        <strong class="font-bold">Validate locally</strong>:
        <code class="rounded-sm border-[1.5px] border-ink bg-paper px-1.5 py-0.5 font-mono text-[13px]"
          >npm install && npm run validate</code
        >.
      </li>
      <li>
        <strong class="font-bold">Open a PR.</strong> The same validation runs in review.
      </li>
    </ol>
  </section>

  <section class="mt-10 max-w-3xl">
    <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Standing orders</h2>
    <ul class="mt-4 list-disc space-y-3 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-verdict-skip">
      {rules.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <section class="nm-card mt-10 max-w-3xl p-6 md:p-8">
    <p class="font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
      the unit is a pull request
    </p>
    <p class="mt-3 text-[17px] leading-relaxed">
      There are no contributor badges, no stars, no votes. Open PRs and adopt-a-page issues are the queue — not a
      leaderboard.
    </p>
    <p class="mt-4 font-mono text-[13px] leading-relaxed text-ink-dim">
      {health.shipBriefed}/{health.ship} ship cards carry a briefing · {health.stale.length} stale
      on <a href="/status/" class="text-accent hover:underline">/status</a>
      {unbriefedShip.length > 0 && (
        <>
          {' '}
          · still unbriefed:{' '}
          {unbriefedShip.map((tool, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/tools/${tool.id}/`} class="text-accent hover:underline">{tool.name}</a>
            </>
          ))}
        </>
      )}
    </p>
  </section>

  <section class="nm-card mt-10 max-w-3xl p-6 md:p-8">
    <p class="font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
      adopt a page · re-check queue
    </p>
    <p class="mt-3 text-[17px] leading-relaxed">
      Least recently verified. Recheck the file, update last_verified, open a PR.
    </p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {
        queue.map((t) => (
          <li>
            <a
              href={`https://github.com/SaneSanders/noemium/edit/main/src/content/tools/${t.id}.yaml`}
              class="nm-num inline-block rounded-md border-[1.5px] border-ink px-3 py-1.5 text-[13px] font-bold transition-all duration-100 hover:-translate-y-0.5 hover:border-accent hover:text-accent"
              rel="noopener"
            >
              {t.data.name}
              <span class="ml-2 font-mono text-[13px] font-normal tracking-wide text-ink-dim">{t.data.last_verified}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="mt-10 max-w-3xl font-mono text-[13px] leading-relaxed text-ink-dim">
    Building an agent? Paste <a href="/llms.txt" class="text-accent hover:underline">noemium.com/llms.txt</a>.
    Raw dumps: <a href="/api/tools.json" class="text-accent hover:underline">/api/tools.json</a>,
    <a href="/api/stacks.json" class="text-accent hover:underline">/api/stacks.json</a>,
    <a href="/api/models.json" class="text-accent hover:underline">/api/models.json</a>.
  </p>

  <section class="mt-10 flex flex-wrap gap-4">
    <a
      href="https://github.com/SaneSanders/noemium/pulls"
      class="nm-btn nm-btn-solid"
      rel="noopener"
    >
      Open pull requests
    </a>
    <a
      href="https://github.com/SaneSanders/noemium/issues?q=is%3Aopen+label%3Aadopt-a-page"
      class="nm-btn nm-btn-outline"
      rel="noopener"
    >
      Adopt-a-page issues
    </a>
    <a
      href="https://github.com/SaneSanders/noemium"
      class="nm-btn nm-btn-outline"
      rel="noopener"
    >
      Open the repository
    </a>
    <a
      href="https://github.com/SaneSanders/noemium/blob/main/CONTRIBUTING.md"
      class="nm-btn nm-btn-outline"
      rel="noopener"
    >
      Read CONTRIBUTING.md
    </a>
    <a
      href="https://github.com/SaneSanders/noemium/tree/main/src/content"
      class="nm-btn nm-btn-outline"
      rel="noopener"
    >
      Browse the templates
    </a>
  </section>
</Base>
