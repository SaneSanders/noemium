---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ModelTable, { type ModelRecord } from '../islands/ModelTable';
import priceHistory from '../data/price-history.json';
import { providerLogoSrc } from '../lib/logos';

const models = await getCollection('models');
const modelNames = new Map(models.map((m) => [m.id, m.data.name]));
const data: ModelRecord[] = models.map((m) => ({
  slug: m.id,
  name: m.data.name,
  provider: m.data.provider,
  context_window: m.data.context_window,
  price_input_per_mtok: m.data.price_input_per_mtok,
  price_output_per_mtok: m.data.price_output_per_mtok,
  price_unit: m.data.price_unit ?? 'mtok',
  price_amount: m.data.price_amount,
  price_currency: m.data.price_currency,
  open_weights: m.data.open_weights,
  popularity: m.data.popularity,
  best_for: m.data.best_for,
  avoid_for: m.data.avoid_for,
  retiring: m.data.retiring
    ? {
        date: m.data.retiring.date,
        successor: m.data.retiring.successor,
        successorName: modelNames.get(m.data.retiring.successor) ?? m.data.retiring.successor,
      }
    : undefined,
  benchmarks: m.data.benchmarks,
  source_attribution: m.data.source_attribution,
  logo: providerLogoSrc(m.data.provider),
}));

const latestVerified = models.map((m) => m.data.last_verified).sort().at(-1);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Noemium AI models catalog',
  itemListElement: data.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.name,
    url: new URL(`/models/#${m.slug}`, Astro.site).href,
  })),
};

// Price audit — models whose prices actually moved since tracking began.
type Point = { date: string; in: number; out: number; unit: string; amount: number | null };
const price = (p: Point) =>
  p.unit === 'mtok' ? `$${p.in}/$${p.out} per 1M in/out` : `$${p.amount} per ${p.unit.replace('_', ' ')}`;
const movers = ((priceHistory as { models: { slug: string; name: string; points: Point[] }[] }).models ?? [])
  .filter((m) => m.points.length > 1)
  .map((m) => {
    const from = m.points.at(-2)!;
    const to = m.points.at(-1)!;
    const base = from.unit === 'mtok' ? (from.in || from.out) : from.amount ?? 0;
    const now = to.unit === 'mtok' ? (to.in || to.out) : to.amount ?? 0;
    const delta = base > 0 ? Math.round(((now - base) / base) * 100) : null;
    return { name: m.name, slug: m.slug, from, to, delta, date: to.date };
  });
const trackingSince = (priceHistory as { started_tracking: string | null }).started_tracking;
---

<Base
  title="Models"
  description="Model prices, context windows and cost per real task — sourced from vendor pages and open pricing datasets."
>
  <SectionHeader
    title="Models"
    sub={latestVerified ? `Reviewed ${latestVerified}. Click a column to sort.` : 'Click a column to sort.'}
  />
  <ModelTable client:load models={data} />

  <section class="mt-14">
    <h2 class="font-mono text-[14px] font-medium tracking-[0.08em] text-ink uppercase">Price audit</h2>
    <p class="mt-3 max-w-3xl font-mono text-[14px] leading-relaxed text-ink-dim">
      Git history since {trackingSince ?? '—'}.
    </p>
    {
      movers.length > 0 ? (
        <ul class="nm-card mt-5 divide-y-[1.5px] divide-line-soft">
          {movers.map((m) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 p-4 text-sm">
              <span class="font-bold">
                {m.name}
                <span class="ml-2 font-mono text-[13px] font-normal tracking-wide text-ink-dim">{m.date}</span>
              </span>
              <span class="nm-num">
                <span class="text-ink-dim line-through">{price(m.from)}</span>
                <span class="mx-2" aria-hidden="true">→</span>
                <span class="font-bold text-accent">{price(m.to)}</span>
                {m.delta !== null && (
                  <span class={`ml-3 font-bold ${m.delta <= 0 ? 'text-verdict-ship' : 'text-verdict-skip'}`}>
                    {m.delta > 0 ? '▲' : '▼'} {Math.abs(m.delta)}%
                  </span>
                )}
              </span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-5 font-mono text-xs text-ink-dim">
          No repricing observed since tracking began. Quiet is a fact too.
        </p>
      )
    }
  </section>

  <p class="mt-10">
    <a
      href="https://github.com/SaneSanders/noemium/tree/main/src/content/models"
      class="nm-btn nm-btn-outline"
      rel="noopener"
    >
      Edit the data on GitHub
    </a>
  </p>

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    is:inline
  />
</Base>
