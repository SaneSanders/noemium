---
import changelog from '../data/changelog.json';
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import CopyButton from '../components/CopyButton.astro';
import { formatChangeValue } from '../lib/changelog-value';
import { formatWeekThread } from '../lib/week-thread';

type Entry = { collection: string; slug: string; name: string; category?: string };
type Change = Entry & { field: string; from: string | number | null; to: string | number | null };
type RiskEvent = {
  class: 'price_change' | 'verdict_change' | 'retirement' | 'death';
  collection: string;
  slug: string;
  name: string;
  detail: string;
};
type Week = {
  id: string;
  from: string;
  to: string;
  counts: { added: number; removed: number; changed: number };
  added: Entry[];
  removed: Entry[];
  changed: Change[];
  risk?: RiskEvent[];
};

const weeks = changelog.weeks as Week[];
const link = (e: Entry) =>
  e.collection === 'tools'
    ? `/tools/${e.slug}/`
    : e.collection === 'agents'
      ? `/agents/${e.slug}/`
      : e.collection === 'stacks'
        ? `/stacks/${e.slug}/`
        : undefined;
const commitsHref = (w: Week) =>
  `https://github.com/SaneSanders/noemium/commits/main/src/content?since=${w.from}&until=${w.to}`;
const short = (v: unknown) => {
  const s = formatChangeValue(v);
  return s.length > 72 ? `${s.slice(0, 69)}…` : s;
};
// Risk detail strings look like "price note: was → now" or "retiring DATE → X".
// Split them into a was/now pair when possible; otherwise render raw.
const parseRiskDetail = (detail: string) => {
  if (!detail) return null;
  const m = detail.match(/^([^:]{1,40}):\s*(.*)$/);
  const field = m?.[1] ?? '';
  const rest = (m?.[2] ?? detail).trim();
  const i = rest.indexOf(' → ');
  if (i === -1) return null;
  return { field, was: rest.slice(0, i), now: rest.slice(i + 3) };
};
---

<Base
  title="Weekly changelog"
  description="Weekly git diff of the Noemium repo — cards added, removed or repriced. Not a market index, not a daily feed."
>
  <SectionHeader title="Changelog" sub="Git of this repo, not the market." />

  <div class="space-y-6">
    {
      weeks.map((w, i) => (
        <details class="nm-card group p-7" open={i === 0}>
          <summary class="flex cursor-pointer list-none flex-wrap items-baseline justify-between gap-x-6 gap-y-3 [&::-webkit-details-marker]:hidden">
            <h2 class="flex items-baseline gap-4 font-display text-4xl font-medium tracking-tight">
              {w.id}
              <span
                aria-hidden="true"
                class="font-mono text-2xl font-bold text-accent transition-transform duration-100 group-open:rotate-45"
              >
                +
              </span>
            </h2>
            <p class="font-mono text-[13px] text-ink-dim">
              {w.from} → {w.to}
            </p>
            <p class="flex items-center gap-4 font-mono text-sm font-bold">
              {w.counts.added > 0 && <span class="text-verdict-ship">+{w.counts.added}</span>}
              {w.counts.removed > 0 && <span class="text-verdict-skip">−{w.counts.removed}</span>}
              {w.counts.changed > 0 && <span class="text-accent">~{w.counts.changed}</span>}
              <a href={commitsHref(w)} class="font-medium text-ink-dim underline-offset-4 hover:text-accent hover:underline" rel="noopener">
                commits →
              </a>
            </p>
          </summary>

          <div class="mt-5 border-t-[1.5px] border-ink pt-6">
            <p class="mb-6">
              <CopyButton label="Copy as X thread" text={formatWeekThread(w)} />
            </p>

            {(w.risk ?? []).length > 0 && (
              <section class="mb-6">
                <h3 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Risk</h3>
                <div class="mt-3 flex flex-wrap gap-2">
                  {Array.from(
                    new Set((w.risk ?? []).map((r) => r.class)),
                  ).map((cls) => (
                    <span class="rounded-sm border border-ink px-2 py-1 font-mono text-[13px] font-medium tracking-[0.14em] uppercase text-ink">
                      {cls.replace('_', ' ')}
                    </span>
                  ))}
                </div>
                <ul class="mt-3 space-y-1">
                  {(w.risk ?? []).map((r) => {
                    const parsed = parseRiskDetail(r.detail);
                    return (
                      <li class="py-2 font-mono text-[13px] text-ink-dim">
                        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                          <span class="text-ink">{r.name}</span>
                          <span class="text-xs tracking-wide text-ink-dim uppercase">
                            {r.class.replace('_', ' ')}{parsed?.field ? ` · ${parsed.field}` : ''}
                          </span>
                        </p>
                        {parsed ? (
                          <div class="mt-1.5 grid grid-cols-[3rem_1fr] items-baseline gap-x-3 gap-y-1 tabular-nums">
                            <span class="uppercase">was</span>
                            <span>{parsed.was}</span>
                            <span class="text-accent uppercase">now</span>
                            <span class="text-ink">{parsed.now}</span>
                          </div>
                        ) : (
                          r.detail && <p class="mt-1.5">{r.detail}</p>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}

            {w.added.length > 0 && (
              <section>
                <h3 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Added</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {w.added.map((e) => {
                    const href = link(e);
                    const item = (
                      <span class="nm-num border-[1.5px] border-ink px-2.5 py-1 text-[13px] font-bold">
                        {e.name}
                        {e.category && <span class="ml-2 font-mono text-[13px] font-normal tracking-wide text-ink-dim">{e.category}</span>}
                      </span>
                    );
                    return (
                      <li>
                        {href ? (
                          <a href={href} class="transition-transform duration-100 hover:-translate-y-0.5">
                            {item}
                          </a>
                        ) : (
                          item
                        )}
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}

            {w.removed.length > 0 && (
              <section class="mt-6">
                <h3 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Removed</h3>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {w.removed.map((e) => (
                    <li>
                      <span class="nm-num border-[1.5px] border-dashed border-ink-dim px-2.5 py-1 text-[13px] font-bold text-ink-dim line-through" title={e.category ?? ''}>
                        {e.name}
                      </span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {w.changed.length > 0 && (
              <section class="mt-6">
                <h3 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Changed</h3>
                <ul class="mt-3 divide-y-[1.5px] divide-line-soft">
                  {w.changed.map((c) => {
                    const href = link(c);
                    const name = href ? (
                      <a href={href} class="font-bold hover:text-accent">
                        {c.name}
                      </a>
                    ) : (
                      <span class="font-bold">{c.name}</span>
                    );
                    return (
                      <li class="py-3 text-[15px]">
                        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                          {name}
                          <span class="font-mono text-xs tracking-wide text-ink-dim uppercase">{c.field}</span>
                        </p>
                        <div class="mt-2 grid grid-cols-[3rem_1fr] items-baseline gap-x-3 gap-y-1 font-mono text-[13px] tabular-nums">
                          <span class="text-ink-dim uppercase">was</span>
                          {c.field === 'verdict' ? (
                            <VerdictBadge verdict={c.from as 'ship' | 'situational' | 'skip'} />
                          ) : (
                            <span class="text-ink-dim line-through">{short(c.from)}</span>
                          )}
                          <span class="text-accent uppercase">now</span>
                          {c.field === 'verdict' ? (
                            <VerdictBadge verdict={c.to as 'ship' | 'situational' | 'skip'} />
                          ) : (
                            <span class="font-bold text-accent">{short(c.to)}</span>
                          )}
                        </div>
                      </li>
                    );
                  })}
                </ul>
              </section>
            )}
          </div>
        </details>
      ))
    }
  </div>

  <p class="mt-10 font-mono text-[13px] text-ink-dim">
    <a href="/prices/" class="text-accent hover:underline">Price tape →</a>
  </p>

  <p class="mt-12 font-mono text-[13px] leading-relaxed text-ink-dim">
    Rebuilt weekly from git history (npm run weekly-diff). Copy edits and last_verified bumps don't
    make the cut — only data that changes a decision. This is a weekly snapshot, not a daily feed.
  </p>
</Base>
