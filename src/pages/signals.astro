---
import { getCollection } from 'astro:content';
import Cover from '../layouts/Cover.astro';
import { collectDeaths } from '../lib/deaths';
import { formatCheckedAt, worldStatusBoard } from '../lib/world-status';
import world from '../data/world-status.json';

const asOf = new Date().toISOString().slice(0, 10);
const models = await getCollection('models');
const tools = await getCollection('tools');
const dead = await getCollection('graveyard');

const { upcoming, past } = collectDeaths({
  asOf,
  models: models.map((m) => ({
    slug: m.id,
    name: m.data.name,
    retiring: m.data.retiring,
  })),
  tools: tools.map((t) => ({
    slug: t.id,
    name: t.data.name,
    limitations: t.data.limitations,
    skip_when: t.data.skip_when,
    verdict_text: t.data.verdict_text,
    price_note: t.data.price_note,
  })),
  graveyard: dead.map((g) => ({
    slug: g.id,
    name: g.data.name,
    died: g.data.died,
    cause: g.data.cause,
    succeeded_by: g.data.succeeded_by,
  })),
});

const graves = past.filter((e) => e.kind === 'grave');
const ended = past.filter((e) => e.kind !== 'grave');
const board = worldStatusBoard(world);
---

<Cover
  title="Signals"
  description="Who is down right now, and what is dying in the next 90 days — public status pages plus ISO dates already in the catalogue."
  page="signals"
>
  <div class="cover-doc">
    <section class="cover-lede">
      <h1>Signals</h1>
      <p>Who is down, and what is ending in the next 90 days.</p>
    </section>

    <p class="cover-kicker">Right now</p>
    {
      board.down.length === 0 ? (
        <p>
          All {board.counts.pages} watched vendors are operational.
          Checked {formatCheckedAt(board.generated_at)}.
        </p>
      ) : (
        <div class="cover-doors">
          {board.down.map((page) => (
            <a class="cover-door" href={page.url} rel="noopener">
              <b>{page.name}</b>
              <span>
                {page.incidents.length ? page.incidents.join('; ') : page.description}
                {page.components.length ? ` [${page.components.join(', ')}]` : ''}
              </span>
            </a>
          ))}
        </div>
      )
    }
    {
      board.up.length > 0 && (
        <p class="cover-note" style="margin-top:14px">
          Quiet: {board.up.map((page) => page.name).join(' · ')}
        </p>
      )
    }
    {
      board.failed.length > 0 && (
        <p class="cover-note" style="margin-top:10px">
          Unreachable: {board.failed.map((page) => page.name).join(' · ')}
        </p>
      )
    }

    <section class="cover-lede">
      <h2>What is <em>ending</em>.</h2>
    </section>

    <p class="cover-kicker">Next 90 days · {asOf}</p>
    {
      upcoming.length === 0 ? (
        <p>No dated sunsets inside 90 days.</p>
      ) : (
        <div class="cover-doors">
          {upcoming.map((e) => (
            <a class="cover-door" href={e.href}>
              <b>{e.name}</b>
              <span>
                {e.date} · {e.days === 0 ? 'today' : e.days === 1 ? '1 day' : `${e.days} days`}
                {e.migrate ? ` → ${e.migrate.name}` : ''}
              </span>
            </a>
          ))}
        </div>
      )
    }

    {
      ended.length > 0 && (
        <>
          <p class="cover-kicker">Already passed</p>
          <div class="cover-doors">
            {ended.map((e) => (
              <a class="cover-door" href={e.href}>
                <b>{e.name}</b>
                <span>{e.date}</span>
              </a>
            ))}
          </div>
        </>
      )
    }

    <p class="cover-kicker">Buried</p>
    <div class="cover-doors">
      {
        graves.map((g) => (
          <a class="cover-door" href="/graveyard/">
            <b>{g.name}</b>
            <span>died {g.date}</span>
          </a>
        ))
      }
    </div>
  </div>
</Cover>
