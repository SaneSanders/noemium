---
import { getCollection } from 'astro:content';
import Cover from '../layouts/Cover.astro';

const models = await getCollection('models');
const dead = await getCollection('graveyard');

const retiring = [...models]
  .filter((m) => m.data.retiring)
  .sort((a, b) => a.data.retiring!.date.localeCompare(b.data.retiring!.date));

const graves = [...dead].sort((a, b) => a.data.died.localeCompare(b.data.died));
---

<Cover
  title="Signals"
  description="What is dying, and what already died — only dates that already live in the catalogue."
  page="signals"
>
  <div class="cover-doc">
    <section class="cover-lede">
      <h1>What is <em>ending</em>.</h1>
      <p>
        Only ISO dates already in the catalogue. No invented sunsets. The full
        death calendar from the lab is the same idea; this door ships the dated
        facts we already have.
      </p>
    </section>

    <p class="cover-lede" style="padding-top:0">
      <strong style="letter-spacing:0.14em;text-transform:uppercase;font-size:10px;color:var(--nm-field)">Retiring</strong>
    </p>
    {
      retiring.length === 0 ? (
        <p>No retirement dates in the catalogue right now.</p>
      ) : (
        <div class="cover-doors">
          {retiring.map((m) => (
            <a class="cover-door" href="/models/">
              <b>{m.data.name}</b>
              <span>retires {m.data.retiring!.date} → {m.data.retiring!.successor}</span>
            </a>
          ))}
        </div>
      )
    }

    <p class="cover-lede">
      <strong style="letter-spacing:0.14em;text-transform:uppercase;font-size:10px;color:var(--nm-field)">Buried</strong>
    </p>
    <div class="cover-doors">
      {
        graves.map((g) => (
          <a class="cover-door" href="/graveyard/">
            <b>{g.data.name}</b>
            <span>died {g.data.died} — {g.data.cause}</span>
          </a>
        ))
      }
    </div>
  </div>
</Cover>
