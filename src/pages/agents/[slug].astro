---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import VerdictBadge from '../../components/VerdictBadge.astro';
import LogoTile from '../../components/LogoTile.astro';
import { agentLayerLabels, evidenceTierLabels, formatCostScenario } from '../../lib/agent-display';

export const getStaticPaths = (async () => {
  const agents = await getCollection('agents');
  return agents.map((agent) => ({ params: { slug: agent.id }, props: { agent } }));
}) satisfies GetStaticPaths;

const { agent } = Astro.props;
const a = agent.data;
const strict = a.evidence_tier !== 'radar';

const hostname = (url: string) => {
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch {
    return url;
  }
};

const sourceLabel = (kind: string) =>
  kind === 'security' ? 'Security / threat model' : `${kind.charAt(0).toUpperCase()}${kind.slice(1)}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: a.name,
  url: a.url,
  description: a.tagline,
  applicationCategory: agentLayerLabels[a.agent_layer],
};
---

<Base title={a.name} description={a.tagline} ogImage={`/og/agents/${agent.id}.png`}>
  <article class="py-14 md:py-20">
    <p class="flex flex-wrap items-center gap-3 font-mono text-[13px] font-medium tracking-[0.14em] text-accent uppercase">
      <span aria-hidden="true" class="inline-block h-0.5 w-9 bg-accent"></span>
      <a href="/agents/" class="hover:underline">Agent field guide</a>
      <span aria-hidden="true" class="text-ink-dim">/</span>
      <span>{agentLayerLabels[a.agent_layer]}</span>
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-4">
      <LogoTile slug={agent.id} name={a.name} size="lg" />
      <h1 class="font-display text-5xl leading-[0.98] font-medium tracking-tight md:text-7xl">{a.name}</h1>
      {a.verdict && <VerdictBadge verdict={a.verdict} class="text-sm" />}
    </div>
    <p class="mt-3 font-mono text-[14px] tracking-[0.12em] text-ink-dim uppercase">
      {a.vendor} · {a.maturity} · {a.license_kind}
    </p>
    <p class="mt-6 max-w-3xl text-xl leading-relaxed font-medium text-ink opacity-80">{a.tagline}</p>

    <p class="mt-7 flex flex-wrap items-center gap-4">
      <a href={a.url} class="nm-btn nm-btn-solid" rel="noopener">Visit {hostname(a.url)} →</a>
      <span class={strict ? 'nm-verified' : 'rounded-sm border-[1.5px] border-dashed border-ink-dim px-2 py-1 font-mono text-[13px] font-bold tracking-[0.12em] text-ink-dim uppercase'}>
        {evidenceTierLabels[a.evidence_tier]} {a.last_verified}
      </span>
    </p>

    <section class="nm-card mt-10 p-6 md:p-8">
      <p class="font-mono text-xs tracking-[0.14em] text-ink-dim uppercase">
        ledger entry · observed by @{a.observed_by}
      </p>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed">{a.verdict_text ?? a.summary}</p>
    </section>

    {!strict && (
      <section class="mt-6 rounded-lg border-[1.5px] border-dashed border-ink p-6">
        <p class="font-mono text-[14px] font-bold tracking-[0.12em] text-ink uppercase">Radar · no verdict</p>
        <p class="mt-2 max-w-3xl text-[15px] leading-relaxed text-ink opacity-75">
          Noemium has confirmed the project exists, but has not reproduced its install, security boundary, or operating cost. This page intentionally omits a verdict and hard price.
        </p>
      </section>
    )}

    <section class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ['layer', agentLayerLabels[a.agent_layer]],
        ['maturity', a.maturity],
        ['deployment', a.deployment.join(' · ')],
        ['evidence', evidenceTierLabels[a.evidence_tier]],
      ].map(([label, value]) => (
        <div class="nm-card p-5">
          <p class="font-mono text-[13px] tracking-[0.12em] text-ink-dim uppercase">{label}</p>
          <p class="mt-2 text-[15px] font-semibold">{value}</p>
        </div>
      ))}
    </section>

    {a.install && (
      <section class="mt-12">
        <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Install</h2>
        <div class="mt-4 grid min-w-0 gap-4 lg:grid-cols-2">
          {a.install.map((method) => (
            <div class="nm-card min-w-0 p-5">
              <p class="break-words font-mono text-[13px] font-bold tracking-[0.12em] text-accent uppercase">{method.method} · {method.platform}</p>
              {method.command && (
                <pre class="mt-4 max-w-full overflow-x-auto rounded-md border-[1.5px] border-ink bg-paper p-4 font-mono text-[13px] leading-relaxed"><code>{method.command}</code></pre>
              )}
              {method.url && <a href={method.url} class="mt-4 inline-block font-mono text-[13px] text-accent hover:underline" rel="noopener">official install source →</a>}
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="mt-12 grid gap-10 lg:grid-cols-2">
      <section>
        <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Best for</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-accent">
          {a.best_for.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      {a.requirements && (
        <section>
          <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Requirements</h2>
          <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-accent">
            {a.requirements.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}
    </div>

    {a.cost_scenarios && (
      <section class="mt-12">
        <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Real cost scenarios</h2>
        <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {a.cost_scenarios.map((scenario) => (
            <div class="nm-card p-5">
              <p class="font-display text-lg font-medium tracking-tight">{scenario.name}</p>
              <p class="nm-num mt-3 text-3xl font-bold text-accent">{formatCostScenario(scenario)}</p>
              <p class="mt-3 text-[13px] leading-relaxed text-ink-dim">{scenario.assumptions}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    {(a.providers || a.channels) && (
      <section class="mt-12 grid gap-8 lg:grid-cols-2">
        {a.providers && (
          <div>
            <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Models and providers</h2>
            <p class="mt-4 flex flex-wrap gap-2">
              {a.providers.map((provider) => <span class="rounded-sm border-[1.5px] border-ink px-2.5 py-1.5 font-mono text-[14px]">{provider}</span>)}
            </p>
          </div>
        )}
        {a.channels && (
          <div>
            <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Channels and surfaces</h2>
            <p class="mt-4 flex flex-wrap gap-2">
              {a.channels.map((channel) => <span class="rounded-sm border-[1.5px] border-ink px-2.5 py-1.5 font-mono text-[14px]">{channel}</span>)}
            </p>
          </div>
        )}
      </section>
    )}

    {a.security && (
      <section class="nm-card mt-12 p-6 md:p-8">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Security boundary</h2>
          <span class="rounded-sm border-[1.5px] border-verdict-skip px-2 py-1 font-mono text-[13px] font-bold tracking-[0.12em] text-verdict-skip uppercase">{a.security.privilege} privilege</span>
        </div>
        <p class="mt-4 max-w-4xl text-[15px] leading-relaxed">{a.security.data_boundary}</p>
        <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-verdict-skip">
          {a.security.cautions.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <section class="mt-12">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Known limitations</h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-[15px] leading-relaxed marker:font-mono marker:text-verdict-skip">
        {a.limitations.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Typed evidence</h2>
      <ol class="mt-4 space-y-3">
        {a.evidence.map((source, index) => (
          <li class="flex min-w-0 flex-wrap items-baseline gap-x-3 gap-y-1 font-mono text-[13px]">
            <sup class="font-bold text-accent">{index + 1}</sup>
            <span class="w-44 shrink-0 font-bold text-ink">{sourceLabel(source.kind)}</span>
            <a href={source.url} class="min-w-0 break-all text-accent hover:underline" rel="noopener">
              {hostname(source.url)}<span class="text-ink-dim">{new URL(source.url).pathname === '/' ? '' : new URL(source.url).pathname}</span>
            </a>
            <span class="nm-num text-[13px] text-ink-dim">checked {source.checked_at}</span>
          </li>
        ))}
      </ol>
    </section>

    <p class="mt-12">
      <a href={`https://github.com/SaneSanders/noemium/edit/main/src/content/agents/${agent.id}.yaml`} class="nm-btn nm-btn-outline" rel="noopener">
        Edit this guide on GitHub
      </a>
    </p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} is:inline />
</Base>
