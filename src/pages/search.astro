---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Base
  title="Search"
  description="Full-text search across every tool, stack and model page in the observatory."
>
  <SectionHeader
    index="06"
    title="Search"
    sub="Full-text search across every observation — tools, stacks and models. The index is static, built at deploy time; nothing leaves your browser."
  />
  <div id="nm-search" class="pb-16"></div>

  <script>
    declare const PagefindUI: any;

    function initSearch() {
      const el = document.getElementById('nm-search');
      if (!el || el.dataset.ready) return;
      el.dataset.ready = '1';

      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      document.head.appendChild(css);

      const script = document.createElement('script');
      script.src = '/pagefind/pagefind-ui.js';
      script.onload = () => {
        new PagefindUI({ element: '#nm-search', showImages: false, showSubResults: true });
      };
      script.onerror = () => {
        el.innerHTML =
          '<p class="font-mono text-xs text-ink-dim">The search index is generated at build time — run <code>npm run build</code> and open the site via <code>npm run preview</code>.</p>';
      };
      document.head.appendChild(script);
    }

    document.addEventListener('astro:page-load', initSearch);
  </script>
</Base>

<style is:global>
  /* Map the Pagefind UI onto Observatory tokens. */
  :root {
    --pagefind-ui-primary: var(--nm-shift-near);
    --pagefind-ui-text: var(--nm-ink);
    --pagefind-ui-background: var(--nm-bg-panel);
    --pagefind-ui-border: var(--nm-line);
    --pagefind-ui-tag: var(--nm-bg-raised);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--nm-radius-md);
    --pagefind-ui-image-border-radius: var(--nm-radius-md);
    --pagefind-ui-font: var(--nm-font-body);
  }

  .pagefind-ui__search-input {
    font-family: var(--nm-font-mono);
    caret-color: var(--nm-shift-near);
  }

  .pagefind-ui__result-title,
  .pagefind-ui__result-link {
    font-family: var(--nm-font-body);
  }

  .pagefind-ui__result-excerpt {
    color: var(--nm-ink-dim);
  }

  .pagefind-ui__result-excerpt mark {
    background-color: transparent;
    color: var(--nm-shift-near);
  }
</style>
