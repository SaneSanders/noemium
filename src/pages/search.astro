---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Base
  title="Search"
  description="⌘K is the catalog search — tools, stacks, models and agent guides. The box on /tools filters the shelf."
>
  <SectionHeader
    title="Search"
    sub="⌘K is the catalog. This page opens the same palette. The search box on /tools only filters the shelf."
  />
  <p class="pb-16 font-mono text-sm text-ink-dim">
    Opening the command palette… if it doesn't, press ⌘K or
    <button
      type="button"
      class="text-accent underline"
      onclick="window.dispatchEvent(new CustomEvent('nm:palette:open'))"
    >
      click here
    </button>
    .
  </p>
  <script>
    function openPalette() {
      window.dispatchEvent(new CustomEvent('nm:palette:open'));
    }
    document.addEventListener('astro:page-load', openPalette);
    openPalette();
  </script>
</Base>
