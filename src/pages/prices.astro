---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import priceHistory from '../data/price-history.json';

type Point = {
  date: string;
  in: number;
  out: number;
  unit: string;
  amount: number | null;
};

type ModelHistory = {
  slug: string;
  name: string;
  points: Point[];
};

const { started_tracking, models } = priceHistory as {
  started_tracking: string | null;
  models: ModelHistory[];
};

const UNIT_LABEL: Record<string, string> = {
  image: '/image',
  video_second: '/video-sec',
  audio_second: '/audio-sec',
  character: '/char',
};

function formatUsd(value: number): string {
  if (value === 0) return '$0.00';
  if (value < 0.01) return `$${value.toPrecision(2)}`;
  if (value < 1) return `$${value.toFixed(3)}`;
  return `$${value.toFixed(2)}`;
}

function currentPrice(m: ModelHistory): string {
  const p = m.points.at(-1)!;
  if (p.unit === 'mtok') return `${formatUsd(p.in)} / ${formatUsd(p.out)} per 1M in/out`;
  return `${formatUsd(p.amount ?? 0)}${UNIT_LABEL[p.unit] ?? `/${p.unit}`}`;
}

function priceChanged(prev: Point, curr: Point): boolean {
  if (curr.unit !== prev.unit) return true;
  if (curr.unit === 'mtok') return prev.in !== curr.in || prev.out !== curr.out;
  return prev.amount !== curr.amount;
}

function latestChange(m: ModelHistory): { text: string; up: boolean } | null {
  if (m.points.length < 2) return null;
  const curr = m.points.at(-1)!;
  const prev = m.points.at(-2)!;
  if (!priceChanged(prev, curr)) return null;

  if (curr.unit === 'mtok') {
    const delta = curr.out - prev.out;
    const pct = prev.out !== 0 ? Math.round((delta / prev.out) * 100) : null;
    return {
      text: `${delta >= 0 ? '+' : ''}${formatUsd(delta)}${pct !== null ? ` (${delta >= 0 ? '+' : ''}${pct}%)` : ''}`,
      up: delta > 0,
    };
  }
  const delta = (curr.amount ?? 0) - (prev.amount ?? 0);
  const base = prev.amount ?? 0;
  const pct = base !== 0 ? Math.round((delta / base) * 100) : null;
  return {
    text: `${delta >= 0 ? '+' : ''}${formatUsd(delta)}${pct !== null ? ` (${delta >= 0 ? '+' : ''}${pct}%)` : ''}`,
    up: delta > 0,
  };
}

const rows = models
  .map((m) => ({
    ...m,
    current: currentPrice(m),
    change: latestChange(m),
    latestDate: m.points.at(-1)!.date,
    hasMove: m.points.length >= 2 && m.points.slice(1).some((p, i) => priceChanged(m.points[i], p)),
  }))
  .sort((a, b) => {
    if (a.hasMove && !b.hasMove) return -1;
    if (!a.hasMove && b.hasMove) return 1;
    return a.name.localeCompare(b.name);
  });

const movers = rows.filter((r) => r.hasMove);
---

<Base
  title="Price tape"
  description={`Model price moves from the git history of this repo — not a live vendor ticker. Tracking since ${started_tracking ?? '—'}.`}
>
  <SectionHeader
    title="Price tape"
    sub={`Git of this repo, not a live ticker. Since ${started_tracking ?? '—'}.`}
  />

  {
    movers.length > 0 ? (
      <div class="nm-card overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left">
          <thead>
            <tr class="border-b-[1.5px] border-ink">
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">model</th>
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">current price</th>
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">latest move</th>
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">last move</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b border-line-soft last:border-b-0">
                <td class="p-3 font-body text-[15px] font-bold text-ink">
                  <a href={`/models/#${r.slug}`} class="hover:text-accent">{r.name}</a>
                </td>
                <td class="nm-num p-3 text-[15px]">{r.current}</td>
                <td class="nm-num p-3 text-[15px]">
                  {r.change ? (
                    <span class={r.change.up ? 'text-verdict-skip' : 'text-verdict-ship'}>{r.change.text}</span>
                  ) : (
                    <span class="text-ink-dim">—</span>
                  )}
                </td>
                <td class="p-3 font-mono text-[13px] text-ink-dim">{r.latestDate}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="nm-card border border-dashed border-ink p-6">
        <p class="font-mono text-[13px] font-bold tracking-[0.12em] text-accent uppercase">No moves recorded yet</p>
        <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-ink opacity-80">
          The tape started {started_tracking ?? '—'}; it fills as prices move.
        </p>
      </div>
    )
  }

  <p class="mt-10 font-mono text-[13px] text-ink-dim">
    <a href="/changelog/" class="text-accent hover:underline">Changelog →</a>
  </p>
</Base>
