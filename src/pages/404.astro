---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Not audited yet" description="This page is not in the catalog — maybe the tool simply hasn't been audited yet.">
  <section class="py-24 md:py-32">
    <p class="flex items-center gap-3 font-mono text-[13px] font-medium tracking-[0.14em] text-verdict-skip uppercase">
      <span aria-hidden="true" class="inline-block h-0.5 w-9 bg-verdict-skip"></span>
      ERR / 404
    </p>
    <h1 class="text-shadow-display mt-7 font-display text-7xl leading-[0.94] font-black tracking-tight uppercase md:text-9xl">
      404
    </h1>
    <p class="mt-8 max-w-xl font-display text-2xl font-extrabold tracking-tight uppercase md:text-4xl">
      This tool hasn't been audited yet.
    </p>
    <p class="mt-6 max-w-md text-lg leading-relaxed font-medium text-ink opacity-75">
      The page you asked for is not in the catalog. If the tool exists and
      deserves an entry — propose it. Every recommendation is a PR.
    </p>
    <p class="mt-10 flex flex-wrap gap-4">
      <a
        href="https://github.com/SaneSanders/noemium"
        class="nm-btn nm-btn-solid"
        rel="noopener"
      >
        Propose it via PR
      </a>
      <a href="/" class="nm-btn nm-btn-outline">Back to the catalog</a>
    </p>
  </section>
</Base>
