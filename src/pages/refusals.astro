---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { refusals as entries } from '../data/refusals';
---

<Base
  title="Open Refusal Ledger"
  description="Noemium publishes every offer to pay for placement or influence — and our refusal. Today the count is zero."
>
  <SectionHeader
    title="Open Refusal Ledger"
    sub="Every offer to pay for placement, and every refusal."
  />

  <article class="max-w-3xl space-y-10 pb-16 text-[15px] leading-relaxed">
    <section class="nm-card p-6 md:p-8">
      <p class="text-ink opacity-80">
        This is the public ledger of every offer to pay for placement or influence on Noemium —
        and our answer to it. The catalog is open source, the verdicts are pull requests, and the
        money we declined is listed here.
      </p>
    </section>

    <section>
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Policy</h2>
      <p class="mt-4 text-ink opacity-80">
        We count any proposal that would let money change what appears in the catalog or how it is
        graded. That includes paid listings, paid verdicts, sponsored placement, and
        affiliate-without-disclosure arrangements.
      </p>
      <p class="mt-3 text-ink opacity-80">
        When an offer arrives, we publish the sanitized details — amount, type, date, and
        counterparty category unless they agree to be named — plus our answer. The answer is always
        no.
      </p>
    </section>

    <section>
      <h2 class="flex items-baseline justify-between font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">
        <span>Ledger</span>
        <span class="nm-num text-ink-dim">{entries.length} entries</span>
      </h2>
      <div class="nm-card mt-4 overflow-x-auto">
        <table class="w-full border-collapse bg-card text-left">
          <thead>
            <tr class="border-b-[1.5px] border-ink">
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">date</th>
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">amount</th>
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">type</th>
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">counterparty</th>
              <th class="p-3 font-mono text-[13px] font-normal tracking-[0.12em] text-ink-dim uppercase">answer</th>
            </tr>
          </thead>
          <tbody>
            {entries.length === 0 ? (
              <tr>
                <td class="p-6 font-mono text-[13px] text-ink-dim" colspan={5}>
                  «No offers declined yet. When one arrives, it lands here.»
                </td>
              </tr>
            ) : (
              entries.map((entry) => (
                <tr class="border-b border-line-soft last:border-b-0">
                  <td class="nm-num p-3 text-[13px]">{entry.date}</td>
                  <td class="nm-num p-3 text-[13px]">{entry.amount}</td>
                  <td class="p-3 text-[13px] text-ink">{entry.type}</td>
                  <td class="p-3 text-[13px] text-ink">{entry.counterparty}</td>
                  <td class="p-3 font-mono text-[13px] font-bold text-verdict-skip">{entry.answer}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>

    <section class="nm-card p-6 md:p-8">
      <h2 class="font-mono text-[13px] font-bold tracking-[0.14em] text-ink uppercase">Were you about to make an offer?</h2>
      <p class="mt-4 text-ink opacity-80">
        Please do not. We do not sell listings, verdicts, or placement. If you want to improve the
        catalog, the correct route is a pull request.
      </p>
      <p class="mt-3 font-mono text-[13px] text-ink-dim">
        <a href="/about/" class="text-accent hover:underline">About →</a>
        <span class="mx-2" aria-hidden="true">·</span>
        <a href="/contribute/" class="text-accent hover:underline">Contribute a card</a>
        <span class="mx-2" aria-hidden="true">·</span>
        <a href="https://github.com/SaneSanders/noemium/blob/main/CONTRIBUTING.md" class="text-accent hover:underline" rel="noopener">CONTRIBUTING.md</a>
      </p>
    </section>
  </article>
</Base>
