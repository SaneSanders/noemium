---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { refusals } from '../data/refusals';

const ledgerLine =
  refusals.length === 0
    ? 'The refusal ledger is zero.'
    : `The refusal ledger lists ${refusals.length} declined offer${refusals.length === 1 ? '' : 's'}.`;
---

<Base
  title="Why directories lie"
  description="Star averages, paid slots, and undated prices are costumes. A catalog is a git log or it is marketing."
>
  <SectionHeader title="Why directories lie" />

  <article class="max-w-2xl space-y-8 pb-16 text-[17px] leading-relaxed">
    <section>
      <h2 class="font-mono text-[14px] font-medium tracking-[0.08em] text-ink uppercase">Stars</h2>
      <p class="mt-3">
        A 4.8 from eleven reviews is not a measurement. The unit is a pull request: one file, one
        observer, one date.
      </p>
    </section>

    <section>
      <h2 class="font-mono text-[14px] font-medium tracking-[0.08em] text-ink uppercase">Paid slots</h2>
      <p class="mt-3">
        Featured that you can buy is advertising. Ours is editorial.
        Affiliates are declared.
        {' '}
        <a href="/refusals/" class="text-accent hover:underline">Refusal ledger</a>. {ledgerLine}
      </p>
    </section>

    <section>
      <h2 class="font-mono text-[14px] font-medium tracking-[0.08em] text-ink uppercase">Undated prices</h2>
      <p class="mt-3">
        We print a price only with a receipt and a date. The trail is git of this repo, not a live ticker.
      </p>
    </section>

    <section>
      <h2 class="font-mono text-[14px] font-medium tracking-[0.08em] text-ink uppercase">No skip</h2>
      <p class="mt-3">
        Limitations are required. Ship is not a trophy.
      </p>
    </section>

    <p>
      <a href="/contribute/" class="text-accent hover:underline">Contribute</a>
      {' · '}
      <a href="/method/" class="text-accent hover:underline">Method</a>
    </p>
  </article>
</Base>
