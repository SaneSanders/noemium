---
import { getCollection } from 'astro:content';
import Cover from '../layouts/Cover.astro';
import { collectFree } from '../lib/free';

const tools = await getCollection('tools');
const buckets = collectFree(
  tools.map((t) => ({
    slug: t.id,
    name: t.data.name,
    pricing: t.data.pricing,
    free_tier: t.data.free_tier,
    open_source: t.data.open_source,
    self_host: t.data.self_host,
    verdict: t.data.verdict,
    price_note: t.data.price_note,
    limitations: t.data.limitations,
    skip_when: t.data.skip_when,
  })),
);

const runIt = buckets['run-it'];
const hosted = buckets['hosted-free'];
const bait = buckets.bait;
const shipTier = buckets['usable-tier'].filter((t) => t.verdict === 'ship');
const restTier = buckets['usable-tier'].length - shipTier.length;
---

<Cover
  title="Actually free"
  description="What the catalogue says you can use at $0 — and which free tiers are a trial, expiring credits, or a temporary promo. No invented prices."
  page="reference"
>
  <div class="cover-doc">
    <section class="cover-lede">
      <h1>What is <em>actually</em> free.</h1>
      <p>
        {runIt.length + hosted.length} priced free.
        {bait.length} bait — trial, expiring credits, or a promo. From the cards, not a scrape.
      </p>
    </section>

    {
      bait.length > 0 && (
        <>
          <p class="cover-kicker">Bait</p>
          <div class="cover-doors">
            {bait.map((t) => (
              <a class="cover-door" href={`/tools/${t.slug}/`}>
                <b>{t.name}</b>
                <span>{t.evidence}</span>
              </a>
            ))}
          </div>
        </>
      )
    }

    <p class="cover-kicker">Run it</p>
    <p class="cover-note">Open source, self-host. You still pay the model and the machine.</p>
    <div class="cover-doors">
      {
        runIt.map((t) => (
          <a class="cover-door" href={`/tools/${t.slug}/`}>
            <b>{t.name}</b>
            <span>{t.evidence ?? 'open source, self-host'}</span>
          </a>
        ))
      }
    </div>

    <p class="cover-kicker">Hosted free</p>
    <div class="cover-doors">
      {
        hosted.map((t) => (
          <a class="cover-door" href={`/tools/${t.slug}/`}>
            <b>{t.name}</b>
            <span>{t.evidence ?? 'priced free in the catalogue'}</span>
          </a>
        ))
      }
    </div>

    <p class="cover-kicker">Ship, with a free tier</p>
    <p class="cover-note">
      {restTier} more freemium cards live in the <a href="/tools/">catalogue</a>.
    </p>
    <div class="cover-doors">
      {
        shipTier.map((t) => (
          <a class="cover-door" href={`/tools/${t.slug}/`}>
            <b>{t.name}</b>
            <span>{t.evidence ?? 'free tier'}</span>
          </a>
        ))
      }
    </div>
  </div>
</Cover>
