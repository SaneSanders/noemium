# Local-only. Copy to `.env` if you need a value.
# Never commit a real token.

# Cloudflare Web Analytics beacon token (privacy-friendly, not Google).
# Create a Web Analytics property in the Cloudflare dashboard, then paste the token.
# Leave empty to ship without a counter.
PUBLIC_CF_BEACON_TOKEN=

# Access key for the local-only /decide experiment form submission.
# Only needed when running the /decide page locally; never used on the public site.
PUBLIC_DECIDE_FORM_ACCESS_KEY=
