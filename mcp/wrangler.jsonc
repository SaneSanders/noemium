{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noemium-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "mcp.noemium.com", "custom_domain": true }],
  "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "noemium_mcp" }],
  "observability": { "enabled": true }
}
